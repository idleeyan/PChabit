<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ============================================================
    PChabit.HardwareMonitor — 硬件监控模块
    移植自 LiteMonitor (https://github.com/Diorser/LiteMonitor, MIT License)
    仅保留数据采集核心（LibreHardwareMonitor + 性能计数器），
    去除 UI / 插件 / 流量历史 / 内核驱动安装等外围功能。
    ============================================================
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PChabit.HardwareMonitor</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- 上游 LiteMonitor 移植代码自带的可空性警告（CS86xx），与上游构建行为保持一致，仅抑制不清除 -->
    <NoWarn>$(NoWarn);CA1416;CS8600;CS8601;CS8602;CS8603;CS8618;CS8625</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="NOTICE.md" Pack="false" />
  </ItemGroup>

</Project>
