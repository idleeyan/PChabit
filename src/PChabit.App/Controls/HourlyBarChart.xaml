<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="PChabit.App.Controls.HourlyBarChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        3.35.0：统一 4 处「每小时分布」图表。
        行由代码生成（ProgressBar 的 Maximum 依赖整组数据，只能整表重建）。
        ScrollViewer 仅在 Scrollable=true 时生效，由代码设置 MaxHeight。
    -->
    <Grid>
        <TextBlock
            x:Name="EmptyHintText"
            FontSize="12"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="所选范围内暂无数据" />

        <ScrollViewer
            x:Name="ChartPanel"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel x:Name="RowHost" Spacing="0" />
        </ScrollViewer>
    </Grid>
</UserControl>