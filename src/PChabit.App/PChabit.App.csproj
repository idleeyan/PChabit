    <Target Name="RemoveUnusedMuiLanguageFolders" AfterTargets="Build" Condition="Exists('$(OutDir)')">
        <ItemGroup>
            <_OutDirEntryFortrim Include="$([System.IO.Directory]::GetDirectories('$(OutDir)'))" />
            <_MuiLanguageDir Include="@(_OutDirEntryFortrim)"
                             Condition="Exists('%(Identity)\Microsoft.ui.xaml.dll.mui')" />
            <_KeepLangEntry Include="$(KeepLanguageFolders.Split(';'))" />
            <_KeepLangDirFull Include="@(_KeepLangEntry->'$(OutDir)%(Identity)\')" />
            <!-- 闂佸憡鍔栭妵鐐电礊閹寸偟鈹嶆繝闈涱儐閻濓箓鏌ㄥ☉娆掑鐎规挸妫欓幏鍛存嚄椤栨粎顔愭繛瀛樼矋缁嬫挸煤閹峰被浜归柡鍥ュ灩濞咃繝鎮樿箛鎾搭棡婵炶偐鏁诲畷娆撴惞閻熸壆鐤€闂佸憡鑹鹃懟顖炲箖?.mui闂佹寧绋戞總鏃傚姬閸愨晝鈻旂€广儱鎳庡Λ妯衡槈閹惧啿顒㈢紒鏂款煼閹?-->
            <_ProtectedDirName Include="Assets;Views;extensions;Microsoft.UI.Xaml;runtimes" />
            <_ProtectedDirFull Include="@(_ProtectedDirName->'$(OutDir)%(Identity)\')" />
        </ItemGroup>
        <ItemGroup>
            <_MuiLanguageDirToDelete Include="@(_MuiLanguageDir)"
                                     Exclude="@(_KeepLangDirFull);@(_ProtectedDirFull)" />
        </ItemGroup>
        <!-- 闁荤姴娲ら敃銉╁蓟閸ヮ剚鍋ㄦい顓熷笧缁€?v:d 闂佸憡鐟崹鐢革綖閸℃稒鏅鑸电〒缁愭鏌熼悜妯虹瑲闁绘搫绱曢幏鐘活敇閳锯偓閺嬪懘鏌ｉ埡濠傛灈缂傚秴绉瑰畷姘跺Χ閸涱垱姣庢繛鎴炴崄濡椼劎绱炲澶婂珘妞ゅ繐瀚崵鎺戔槈?-->
        <Message Text="[PCH-LANG][Build] OutDir=$(OutDir)" Importance="low" />
        <Message Text="[PCH-LANG][Build] candidates=@(_MuiLanguageDir)" Importance="low" />
        <Message Text="[PCH-LANG][Build] keep=@(_KeepLangDirFull)" Importance="low" />
        <Message Text="[PCH-LANG][Build] delete=@(_MuiLanguageDirToDelete)" Importance="low" />
        <RemoveDir Directories="@(_MuiLanguageDirToDelete)"
                   Condition="'@(_MuiLanguageDirToDelete)' != ''" />
        <Message Text="mui-clean" Importance="low" />
    </Target>

    <Target Name="RemoveUnusedMuiLanguageFoldersForPublish" AfterTargets="Publish" Condition="Exists('$(PublishDir)')">
        <ItemGroup>
            <_PublishEntryFortrim Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)'))" />
            <_MuiLanguageDirForPublish Include="@(_PublishEntryFortrim)"
                                       Condition="Exists('%(Identity)\Microsoft.ui.xaml.dll.mui')" />
            <_KeepLangEntryForPublish Include="$(KeepLanguageFolders.Split(';'))" />
            <_KeepLangDirFullForPublish Include="@(_KeepLangEntryForPublish->'$(PublishDir)%(Identity)\')" />
            <_ProtectedDirNameForPublish Include="Assets;Views;extensions;Microsoft.UI.Xaml;runtimes" />
            <_ProtectedDirFullForPublish Include="@(_ProtectedDirNameForPublish->'$(PublishDir)%(Identity)\')" />
        </ItemGroup>
        <ItemGroup>
            <_MuiLanguageDirToDeleteForPublish Include="@(_MuiLanguageDirForPublish)"
                                               Exclude="@(_KeepLangDirFullForPublish);@(_ProtectedDirFullForPublish)" />
        </ItemGroup>
        <RemoveDir Directories="@(_MuiLanguageDirToDeleteForPublish)"
                   Condition="'@(_MuiLanguageDirToDeleteForPublish)' != ''" />
        <Message Text="mui-clean" Importance="low" />
    </Target>

    <!-- WinUI 3 unpacked publish fix: dotnet publish may miss XBF/PRI files -->
    <Target Name="CopyWinUIAssetsToPublish" AfterTargets="Publish">
