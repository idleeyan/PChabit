<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
        <OutputType>WinExe</OutputType>
        <UseWinUI>true</UseWinUI>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>PChabit</RootNamespace>
        <AssemblyName>PChabit</AssemblyName>
        <Product>PChabit</Product>
        <Version>4.11.0</Version>
        <Platforms>x64</Platforms>
        <PlatformTarget>x64</PlatformTarget>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
        <SelfContained>true</SelfContained>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>pchabit.ico</ApplicationIcon>
        <EnableMsixTooling>false</EnableMsixTooling>
        <WindowsPackageType>None</WindowsPackageType>
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <WindowsAppSDKUndockedRegFreeWinRTInitializeAtStartup>true</WindowsAppSDKUndockedRegFreeWinRTInitializeAtStartup>
        <WindowsAppSDKBootstrapInitializeAtStartup>true</WindowsAppSDKBootstrapInitializeAtStartup>
        <EnableMrtTargets>false</EnableMrtTargets>
        <SatelliteResourceLanguages>en-US;zh-CN</SatelliteResourceLanguages>
        <NoWarn>$(NoWarn);MVVMTK0045;NETSDK1206</NoWarn>
        <PublishReadyToRun>false</PublishReadyToRun>
        <TieredPGO>true</TieredPGO>
    </PropertyGroup>

    <PropertyGroup>
        <KeepLanguageFolders Condition="'$(KeepLanguageFolders)' == ''">zh-CN;en-us</KeepLanguageFolders>
    </PropertyGroup>

    <Target Name="EnsureMicrosoftUIXamlInPublish" AfterTargets="Publish">
        <ItemGroup>
            <_MuxFilesForPublish Include="$(OutDir)Microsoft.UI.Xaml\**\*.*"
                                 Condition="Exists('$(OutDir)Microsoft.UI.Xaml')" />
        </ItemGroup>
        <Copy SourceFiles="@(_MuxFilesForPublish)"
              DestinationFiles="$(PublishDir)Microsoft.UI.Xaml\%(RecursiveDir)%(Filename)%(Extension)"
              SkipUnchangedFiles="true"
              Condition="'@(_MuxFilesForPublish)' != '' And Exists('$(PublishDir)')" />
        <Message Text="閻庣懓鎲¤ぐ鍐啅闁秴绀嗛悹杞拌濡插鏌?Microsoft.UI.Xaml 闂?$(PublishDir) (@(_MuxFilesForPublish->Count()) 婵炴垶鎼╂禍婵嬪几閸愨晝顩?" Importance="high" />
    </Target>

    <Target Name="RemoveUnusedMuiLanguageFolders" AfterTargets="Build" Condition="Exists('$(OutDir)')">
        <ItemGroup>
            <_OutDirEntryFortrim Include="$([System.IO.Directory]::GetDirectories('$(OutDir)'))" />
            <_MuiLanguageDir Include="@(_OutDirEntryFortrim)"
                             Condition="Exists('%(Identity)\Microsoft.ui.xaml.dll.mui')" />
            <_KeepLangEntry Include="$(KeepLanguageFolders.Split(';'))" />
            <_KeepLangDirFull Include="@(_KeepLangEntry->'$(OutDir)%(Identity)\')" />
            <_ProtectedDirName Include="Assets;Views;extensions;Microsoft.UI.Xaml;runtimes" />
            <_ProtectedDirFull Include="@(_ProtectedDirName->'$(OutDir)%(Identity)\')" />
        </ItemGroup>
        <ItemGroup>
            <_MuiLanguageDirToDelete Include="@(_MuiLanguageDir)"
                                     Exclude="@(_KeepLangDirFull);@(_ProtectedDirFull)" />
        </ItemGroup>
        <Message Text="[PCH-LANG][Build] OutDir=$(OutDir)" Importance="low" />
        <Message Text="[PCH-LANG][Build] candidates=@(_MuiLanguageDir)" Importance="low" />
        <Message Text="[PCH-LANG][Build] keep=@(_KeepLangDirFull)" Importance="low" />
        <Message Text="[PCH-LANG][Build] delete=@(_MuiLanguageDirToDelete)" Importance="low" />
        <RemoveDir Directories="@(_MuiLanguageDirToDelete)"
                   Condition="'@(_MuiLanguageDirToDelete)' != ''" />
        <Message Text="mui-clean" Importance="low" />
    </Target>

    <Target Name="RemoveUnusedMuiLanguageFoldersForPublish" AfterTargets="Publish" Condition="Exists('$(PublishDir)')">
        <ItemGroup>
            <_PublishEntryFortrim Include="$([System.IO.Directory]::GetDirectories('$(PublishDir)'))" />
            <_MuiLanguageDirForPublish Include="@(_PublishEntryFortrim)"
                                       Condition="Exists('%(Identity)\Microsoft.ui.xaml.dll.mui')" />
            <_KeepLangEntryForPublish Include="$(KeepLanguageFolders.Split(';'))" />
            <_KeepLangDirFullForPublish Include="@(_KeepLangEntryForPublish->'$(PublishDir)%(Identity)\')" />
            <_ProtectedDirNameForPublish Include="Assets;Views;extensions;Microsoft.UI.Xaml;runtimes" />
            <_ProtectedDirFullForPublish Include="@(_ProtectedDirNameForPublish->'$(PublishDir)%(Identity)\')" />
        </ItemGroup>
        <ItemGroup>
            <_MuiLanguageDirToDeleteForPublish Include="@(_MuiLanguageDirForPublish)"
                                               Exclude="@(_KeepLangDirFullForPublish);@(_ProtectedDirFullForPublish)" />
        </ItemGroup>
        <RemoveDir Directories="@(_MuiLanguageDirToDeleteForPublish)"
                   Condition="'@(_MuiLanguageDirToDeleteForPublish)' != ''" />
        <Message Text="mui-clean" Importance="low" />
    </Target>

    <!-- WinUI 3 unpacked publish fix: dotnet publish may miss XBF/PRI files -->
    <Target Name="CopyWinUIAssetsToPublish" AfterTargets="Publish">
        <PropertyGroup>
            <WinUIBuildOutput>$(OutDir)</WinUIBuildOutput>
        </PropertyGroup>
        <Copy SourceFiles="$(WinUIBuildOutput)PChabit.pri" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('$(WinUIBuildOutput)PChabit.pri')" />
        <Copy SourceFiles="$(WinUIBuildOutput)App.xbf" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('$(WinUIBuildOutput)App.xbf')" />
        <ItemGroup>
            <WinUIBuildXbf Include="$(WinUIBuildOutput)Views\**\*.xbf" />
        </ItemGroup>
        <Copy SourceFiles="@(WinUIBuildXbf)" DestinationFolder="$(PublishDir)Views\%(RecursiveDir)" SkipUnchangedFiles="true" />
        <Message Text="mui-clean" Importance="low" />
    </Target>

    <Target Name="CopyNativeSqliteToOutput" AfterTargets="Build">
        <ItemGroup>
            <_SqliteNativeCandidate Include="$(NuGetPackageRoot)sqlitepclraw.lib.e_sqlite3\**\runtimes\win-x64\native\e_sqlite3.dll" />
        </ItemGroup>
        <PropertyGroup>
            <SqliteNativeDestDir>$(OutDir)runtimes\win-x64\native</SqliteNativeDestDir>
        </PropertyGroup>
        <Copy SourceFiles="@(_SqliteNativeCandidate)" DestinationFolder="$(SqliteNativeDestDir)" SkipUnchangedFiles="true" Condition="'@(_SqliteNativeCandidate)' != ''" />
        <Message Text="閻庣懓鎲¤ぐ鍐囬弻銉ョ?e_sqlite3.dll 闂?$(SqliteNativeDestDir)" Importance="normal" Condition="'@(_SqliteNativeCandidate)' != ''" />
    </Target>

    <!--
        Publish 后处理（2026-10-03 新增）：
        1) e_sqlite3.dll：CopyNativeSqliteToOutput 只复制到 bin，publish 不自动带
           （deps.json 无 runtimeTargets 声明），缺它则启动后所有页面数据为空（陷阱 11）
        2) Assets\*.png：图标被 pri 引用，SOP 2 要求发布产物齐全；bin 有而 publish 缺，补复制
        3) BuildHost-net472/netcore：bin 历史遗留的 Roslyn 测试宿主，与运行无关，从发布目录清理
    -->
    <Target Name="CopySqliteAndAssetsToPublish" AfterTargets="Publish">
        <PropertyGroup>
            <_NativeSqliteSrc>$(OutDir)runtimes\win-x64\native\e_sqlite3.dll</_NativeSqliteSrc>
        </PropertyGroup>
        <Copy SourceFiles="$(_NativeSqliteSrc)" DestinationFolder="$(PublishDir)runtimes\win-x64\native\" SkipUnchangedFiles="true" Condition="Exists('$(_NativeSqliteSrc)')" />
        <ItemGroup>
            <_AssetPngForPublish Include="$(OutDir)Assets\*.png" />
        </ItemGroup>
        <Copy SourceFiles="@(_AssetPngForPublish)" DestinationFolder="$(PublishDir)Assets\" SkipUnchangedFiles="true" Condition="'@(_AssetPngForPublish)' != ''" />
        <RemoveDir Directories="$(PublishDir)BuildHost-net472" Condition="Exists('$(PublishDir)BuildHost-net472')" />
        <RemoveDir Directories="$(PublishDir)BuildHost-netcore" Condition="Exists('$(PublishDir)BuildHost-netcore')" />
        <Message Text="[PCH-PUB] e_sqlite3.dll 与 Assets png 已补齐到发布目录，BuildHost 已清理" Importance="high" />
    </Target>

    <ItemGroup>
        <ProjectReference Include="..\PChabit.Application\PChabit.Application.csproj" />
        <ProjectReference Include="..\PChabit.Infrastructure\PChabit.Infrastructure.csproj" />
        <ProjectReference Include="..\PChabit.Core\PChabit.Core.csproj" />
        <ProjectReference Include="..\PChabit.HardwareMonitor\PChabit.HardwareMonitor.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Assets\SplashScreen.scale-200.png" />
        <Content Include="Assets\LockScreenLogo.scale-200.png" />
        <Content Include="Assets\Square150x150Logo.scale-200.png" />
        <Content Include="Assets\Square44x44Logo.scale-200.png" />
        <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
        <Content Include="Assets\StoreLogo.png" />
        <Content Include="Assets\Wide310x150Logo.scale-200.png" />
        <Content Include="Assets\Sankey\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Assets\PieChart\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Assets\Analytics\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="Assets\Dashboard\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="pchabit.ico">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
        <Content Include="..\..\CHANGELOG.md">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>CHANGELOG.md</Link>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Markdig" Version="0.*" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
        <PackageReference Include="Serilog" Version="4.*" />
        <PackageReference Include="Serilog.Sinks.Async" Version="2.*" />
        <PackageReference Include="Serilog.Sinks.File" Version="6.*" />
        <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    </ItemGroup>

    <!--
      Rust 进程网络采样内核（pchabit-netd.exe）。
      只做拷贝、不在这里调 cargo：没有 Rust 工具链的机器也能正常构建；
      内核产物由 rust\pchabit-netd 下手动执行 cargo build（release profile）生成，或由 CI 生成。
      产物缺失时 App 会自动回退到内置 C# 采样，不影响功能。
    -->
    <PropertyGroup>
        <RustNetdDir>$(MSBuildThisFileDirectory)..\..\rust\pchabit-netd</RustNetdDir>
        <RustNetdExe>$(RustNetdDir)\target\release\pchabit-netd.exe</RustNetdExe>
    </PropertyGroup>

    <Target Name="CopyRustNetdToOutput" AfterTargets="Build" Condition="Exists('$(RustNetdExe)')">
        <Copy SourceFiles="$(RustNetdExe)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="CopyRustNetdToPublish" AfterTargets="Publish" Condition="Exists('$(RustNetdExe)')">
        <Copy SourceFiles="$(RustNetdExe)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    </Target>

    <!--
      Rust 数据面（pchabit-datad.exe，P3 第一块）：只读 SQLite 的应用统计计算。
      与 netd 同样是「只拷贝、不调 cargo」，缺失时 RustStatsProvider 自动回退 C# 引擎。
    -->
    <PropertyGroup>
        <RustDatadDir>$(MSBuildThisFileDirectory)..\..\rust\pchabit-datad</RustDatadDir>
        <RustDatadExe>$(RustDatadDir)\target\release\pchabit-datad.exe</RustDatadExe>
    </PropertyGroup>

    <Target Name="CopyRustDatadToOutput" AfterTargets="Build" Condition="Exists('$(RustDatadExe)')">
        <Copy SourceFiles="$(RustDatadExe)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    </Target>

    <Target Name="CopyRustDatadToPublish" AfterTargets="Publish" Condition="Exists('$(RustDatadExe)')">
        <Copy SourceFiles="$(RustDatadExe)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    </Target>

</Project>



