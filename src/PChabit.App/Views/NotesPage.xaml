<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="PChabit.App.Views.NotesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PChabit.App.ViewModels"
    xmlns:controls="using:PChabit.App.Controls"
    x:Name="NotesPageRoot"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,*">
        <StackPanel Padding="24,20,24,12" Spacing="10">
            <Grid>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="便签" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="随时记下想法。Ctrl+Alt+N 全局快速新建，Ctrl+Enter 保存。" />
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ComboBox
                        MinWidth="100"
                        ItemsSource="{x:Bind ViewModel.Filters}"
                        SelectedItem="{x:Bind ViewModel.SelectedFilter, Mode=TwoWay}" />
                    <Button Command="{x:Bind ViewModel.SyncNowCommand}" Content="立即同步" />
                    <Button
                        Click="NewNote_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Content="+ 新建便签" />
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    PlaceholderText="搜索便签内容…"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}"
                    TextChanged="SearchBox_TextChanged" />
                <Button
                    Grid.Column="1"
                    Click="EmptyTrash_Click"
                    Content="清空回收站"
                    Visibility="{x:Bind ViewModel.IsTrashView, Mode=OneWay}" />
            </Grid>
            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <GridView
                Padding="24,4,24,24"
                IsItemClickEnabled="True"
                ItemClick="NotesGrid_ItemClick"
                ItemsSource="{x:Bind ViewModel.Notes}"
                SelectionMode="None">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid ItemWidth="248" ItemHeight="248" Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="MinWidth" Value="248" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:NoteItemViewModel">
                        <Border
                            Margin="6"
                            Padding="14,12"
                            Background="{x:Bind CardBrush}"
                            BorderBrush="{x:Bind AccentBrush}"
                            BorderThickness="0,3,0,0"
                            CornerRadius="6">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <Grid>
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="#665C2B"
                                        Text="📌 置顶"
                                        Visibility="{x:Bind IsPinned}" />
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="11"
                                        Foreground="#8A7C45"
                                        Text="{x:Bind UpdatedText}" />
                                </Grid>
                                <RichTextBlock
                                    Grid.Row="1"
                                    Margin="0,8"
                                    LineHeight="20"
                                    MaxHeight="168"
                                    IsTextSelectionEnabled="False"
                                    controls:MarkdownText.Text="{x:Bind Preview}" />
                                <StackPanel
                                    Grid.Row="2"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <Button
                                        Click="CardPin_Click"
                                        Tag="{x:Bind Id}"
                                        Content="置顶"
                                        FontSize="11"
                                        Padding="8,3"
                                        Visibility="{x:Bind IsTrashItem, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <Button
                                        Click="CardColor_Click"
                                        Tag="{x:Bind Id}"
                                        Content="换色"
                                        FontSize="11"
                                        Padding="8,3"
                                        Visibility="{x:Bind IsTrashItem, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <Button
                                        Click="CardArchive_Click"
                                        Tag="{x:Bind Id}"
                                        Content="归档"
                                        FontSize="11"
                                        Padding="8,3"
                                        Visibility="{x:Bind IsTrashItem, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <Button
                                        Click="CardDelete_Click"
                                        Tag="{x:Bind Id}"
                                        Content="删除"
                                        FontSize="11"
                                        Padding="8,3"
                                        Visibility="{x:Bind IsTrashItem, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                                    <Button
                                        Click="CardRestore_Click"
                                        Tag="{x:Bind Id}"
                                        Content="还原"
                                        FontSize="11"
                                        Padding="8,3"
                                        Visibility="{x:Bind IsTrashItem, Mode=OneWay}" />
                                    <Button
                                        Click="CardDelete_Click"
                                        Tag="{x:Bind Id}"
                                        Content="彻底删除"
                                        FontSize="11"
                                        Padding="8,3"
                                        Visibility="{x:Bind IsTrashItem, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <StackPanel
                VerticalAlignment="Center"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                Spacing="8">
                <TextBlock
                    HorizontalTextAlignment="Center"
                    FontSize="15"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <ContentDialog
            x:Name="EditDialog"
            Title="编辑便签"
            CloseButtonText="取消"
            PrimaryButtonText="保存 (Ctrl+Enter)"
            PrimaryButtonClick="EditDialog_Primary"
            SecondaryButtonClick="EditDialog_Delete"
            Closing="EditDialog_Closing"
            SecondaryButtonText="删除">
            <StackPanel Spacing="12" Width="440">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <RadioButton
                            x:Name="ModeEdit"
                            Content="✏ 编辑"
                            MinWidth="0"
                            Padding="10,4"
                            Checked="Mode_Checked" />
                        <RadioButton
                            x:Name="ModePreview"
                            Content="预览样式"
                            MinWidth="0"
                            Padding="10,4"
                            Checked="Mode_Checked" />
                    </StackPanel>
                    <TextBlock
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="支持 Markdown 语法" />
                </Grid>
                <TextBox
                    x:Name="EditBox"
                    AcceptsReturn="True"
                    Height="220"
                    KeyDown="EditBox_KeyDown"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{x:Bind ViewModel.EditContent, Mode=TwoWay}"
                    TextWrapping="Wrap" />
                <ScrollViewer
                    x:Name="PreviewScroll"
                    Height="220"
                    Padding="10,8"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="Collapsed">
                    <RichTextBlock
                        x:Name="PreviewMd"
                        IsTextSelectionEnabled="True"
                        controls:MarkdownText.Text="{x:Bind ViewModel.EditContent, Mode=OneWay}" />
                </ScrollViewer>
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            Click="ColorPick_Click"
                            Tag="yellow"
                            Background="#FEF3C4"
                            Width="28" Height="28" />
                        <Button
                            Click="ColorPick_Click"
                            Tag="pink"
                            Background="#FCE4EC"
                            Width="28" Height="28" />
                        <Button
                            Click="ColorPick_Click"
                            Tag="blue"
                            Background="#DDECFB"
                            Width="28" Height="28" />
                        <Button
                            Click="ColorPick_Click"
                            Tag="green"
                            Background="#E3F4E3"
                            Width="28" Height="28" />
                        <Button
                            Click="ColorPick_Click"
                            Tag="gray"
                            Background="#EEEEEE"
                            Width="28" Height="28" />
                    </StackPanel>
                    <CheckBox
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="置顶"
                        IsChecked="{x:Bind ViewModel.EditPinned, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </ContentDialog>

        <ContentDialog
            x:Name="ConfirmDialog"
            CloseButtonText="取消"
            PrimaryButtonText="确定" />
    </Grid>
</Page>
