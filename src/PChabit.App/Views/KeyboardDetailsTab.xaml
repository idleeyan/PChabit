<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="PChabit.App.Views.KeyboardDetailsTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="using:PChabit.App.ViewModels"
    xmlns:controls="using:PChabit.App.Controls"
    mc:Ignorable="d">
    
    <ScrollViewer Padding="24">
        <StackPanel Spacing="24">
            <!-- 标题 + 日期切换 -->
            <Grid>
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="键鼠详情" />
                
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Padding="8,4"
                        Click="PreviousDay_Click"
                        Content="&#xE76B;"
                        FontFamily="Segoe MDL2 Assets"
                        ToolTipService.ToolTip="前一天" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.SelectedDate, Converter={StaticResource DateToStringConverter}, Mode=OneWay}" />
                    <Button
                        Padding="8,4"
                        Click="NextDay_Click"
                        Content="&#xE76C;"
                        FontFamily="Segoe MDL2 Assets"
                        ToolTipService.ToolTip="后一天" />
                </StackPanel>
            </Grid>
            
            <!-- ===== 键鼠统计（3.50.0：原「键盘统计」「鼠标统计」两板块合并为同一板块） ===== -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="16">
                    <!-- 板块标题 -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon
                            FontSize="14"
                            Glyph="&#xE92E;"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <FontIcon
                            FontSize="14"
                            Glyph="&#xE962;"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Margin="4,0,0,0"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="键鼠统计" />
                    </StackPanel>

                    <!-- 指标卡：键盘 4 项 + 鼠标 6 项（5 列 × 2 行） -->
                    <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 行 0：键盘 4 项 + 鼠标总点击 -->
                        <Border Grid.Column="0" Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="总按键次数" ToolTipService.ToolTip="当日累计按下的所有按键总数" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind ViewModel.TotalKeyPresses, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="平均速度" ToolTipService.ToolTip="平均打字速度（KPM）" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind ViewModel.AverageSpeed, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="峰值速度" ToolTipService.ToolTip="当日最高打字速度（KPM）" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind ViewModel.PeakSpeed, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="快捷键使用" ToolTipService.ToolTip="快捷键组合总次数" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind ViewModel.ShortcutsUsed, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="4" Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="总点击次数" ToolTipService.ToolTip="当日累计的鼠标点击总数（左键+右键+中键）" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#0078D4" Text="{x:Bind ViewModel.TotalClicks, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <!-- 行 1：鼠标 5 项 -->
                        <Border Grid.Row="1" Grid.Column="0" Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="左键点击" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#107C10" Text="{x:Bind ViewModel.LeftClicks, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="右键点击" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#E81123" Text="{x:Bind ViewModel.RightClicks, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="2" Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="中键点击" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#FF8C00" Text="{x:Bind ViewModel.MiddleClicks, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="3" Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="移动距离" ToolTipService.ToolTip="当日鼠标移动总距离（像素）" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#8764B8" Text="{x:Bind ViewModel.TotalMoveDistance, Mode=OneWay}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="4" Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                            <StackPanel Spacing="4">
                                <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="滚动次数" />
                                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="#00B7C3" Text="{x:Bind ViewModel.TotalScrolls, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 平均点击间隔 -->
                    <Border Padding="12,8" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <TextBlock FontSize="13" VerticalAlignment="Center">
                            <Run Text="平均点击间隔: " Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Run Text="{x:Bind ViewModel.AverageClickInterval, Mode=OneWay}" FontWeight="SemiBold" Foreground="#0078D4" />
                        </TextBlock>
                    </Border>

                    <!-- 按键使用排行 + 编辑统计/常用快捷键 -->
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 按键使用排行 -->
                        <Border Grid.Column="0" Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                            <StackPanel Spacing="16">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="按键使用排行" ToolTipService.ToolTip="使用频率最高的20个按键" />
                                <ListView ItemsSource="{x:Bind ViewModel.KeyUsageList, Mode=OneWay}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModel:KeyUsageItem">
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="60" />
                                                </Grid.ColumnDefinitions>
                                                <Border Padding="8,4" Background="{x:Bind Color}" CornerRadius="4">
                                                    <TextBlock HorizontalAlignment="Center" FontWeight="Medium" Text="{x:Bind KeyName}" />
                                                </Border>
                                                <ProgressBar Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Maximum="100" Value="{x:Bind Percentage}" />
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind Count}" />
                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Percentage, Converter={StaticResource PercentageConverter}}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <!-- 编辑统计 + 常用快捷键 -->
                        <Border Grid.Column="1" Padding="16" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                            <StackPanel Spacing="16">
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="编辑统计" ToolTipService.ToolTip="编辑类按键统计" />
                                <StackPanel Spacing="12">
                                    <Grid>
                                        <TextBlock Text="退格键" />
                                        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{x:Bind ViewModel.BackspaceCount, Mode=OneWay}" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="删除键" />
                                        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{x:Bind ViewModel.DeleteCount, Mode=OneWay}" />
                                    </Grid>
                                </StackPanel>
                                <TextBlock FontSize="16" FontWeight="SemiBold" Text="常用快捷键" ToolTipService.ToolTip="使用最频繁的快捷键组合" />
                                <ListView ItemsSource="{x:Bind ViewModel.TopShortcuts, Mode=OneWay}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewModel:ShortcutItem">
                                            <Grid Margin="0,4">
                                                <TextBlock Text="{x:Bind Shortcut}" />
                                                <TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Count}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            
            <!-- ===== 每小时键鼠统计（3.43.0：长条图合并为四方格，每格左=按键、右=鼠标两个数字） ===== -->
            <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                <StackPanel Spacing="12">
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="每小时键鼠统计" ToolTipService.ToolTip="每格上方为时段，左侧数字为按键次数，右侧蓝色数字为鼠标点击次数；悬停查看鼠标移动/滚动明细" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.HourlyKeyMouseCells, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="12" ItemWidth="92" ItemHeight="52" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModel:HourlyKeyMouseCell">
                                <Border
                                    Margin="0,0,8,8"
                                    Padding="8,4"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    ToolTipService.ToolTip="{x:Bind ToolTip}">
                                    <Grid RowSpacing="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Hour}" />
                                        <Grid Grid.Row="1" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Bind KeyPresses}" ToolTipService.ToolTip="按键次数" />
                                            <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold" Foreground="#0078D4" Text="{x:Bind MouseClicks}" ToolTipService.ToolTip="鼠标点击次数" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            
            <!-- 3.46.0：原「按应用键鼠统计」卡片已删除，并入应用详情弹窗（AppDetailDialog「键鼠统计」卡片，单应用视角） -->

            <!-- 3.50.0：原「鼠标统计」板块（6 指标卡 + 平均点击间隔）已并入上方「键鼠统计」板块 -->
            <!-- 3.46.0：原「按程序鼠标统计」「按应用键鼠统计」均已删除，按应用视角的键鼠统计并入应用详情弹窗 -->
            <!-- 3.45.0：原「鼠标详细记录」卡片已删除（与「每小时键鼠统计」重复且无意义） -->
        </StackPanel>
    </ScrollViewer>
</UserControl>
