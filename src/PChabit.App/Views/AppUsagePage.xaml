<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="PChabit.App.Views.AppUsagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:PChabit.App.Views"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="24,24,24,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="应用使用" />
                <Button
                    Padding="12,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="OpenCategoryManager_Click"
                    Content="分类管理 →" />
            </Grid>
        </Border>

        <!--
            3.34.0：原「应用统计」与「键鼠详情」两页合并为此页的两个页签。
            3.50.0：键鼠页签内键盘统计与鼠标统计已合并为同一「键鼠统计」板块。
            Pivot 内容按子项横向排布测量，页签宿主需把内容 Grid 高度绑定到 Pivot 可视高度，
            恢复内部 ScrollViewer / ListView 的自身滚动（否则内容超出窗口时底部被截断）。
        -->
        <Pivot
            x:Name="RootPivot"
            Grid.Row="1"
            SelectionChanged="RootPivot_SelectionChanged">
            <PivotItem Header="应用排行" Tag="ranking">
                <Grid Height="{Binding ActualHeight, ElementName=RootPivot}">
                    <views:AppStatsTab x:Name="RankingTab" />
                </Grid>
            </PivotItem>
            <PivotItem Header="键鼠详情" Tag="keyboard">
                <Grid Height="{Binding ActualHeight, ElementName=RootPivot}">
                    <views:KeyboardDetailsTab x:Name="KeyboardTab" />
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>