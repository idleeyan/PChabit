<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="PChabit.App.Views.NetworkProcessView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border
        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="10">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16,14,16,12">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="OnEscapeInvoked" />
            </Grid.KeyboardAccelerators>

            <!--  标题行  -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <TextBlock
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Text="实时网速 · 进程排行" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{Binding UpdatedText}" />
            </Grid>

            <!--  系统实时速率：下载为主焦点，上传次之  -->
            <Grid
                Grid.Row="1"
                Margin="0,12,0,4"
                ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock
                        Margin="0,0,0,5"
                        VerticalAlignment="Bottom"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#185FA5"
                        Text="↓" />
                    <TextBlock
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Text="{Binding DownText}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="5">
                    <TextBlock
                        Margin="0,0,0,5"
                        VerticalAlignment="Bottom"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="#0F6E56"
                        Text="↑" />
                    <TextBlock
                        VerticalAlignment="Bottom"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{Binding UpText}" />
                </StackPanel>
            </Grid>

            <!--  进程排行（ItemsControl：无选中态，纯展示更紧凑）  -->
            <ScrollViewer
                Grid.Row="2"
                Margin="0,4,0,0"
                VerticalScrollBarVisibility="Auto"
                Visibility="{Binding ListVisibility}">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Padding="0,6"
                                ColumnDefinitions="20,*,78,78"
                                RowDefinitions="Auto,Auto">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{Binding RankText}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    Text="{Binding ProcessName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    FontSize="12"
                                    Foreground="#185FA5"
                                    Text="{Binding DownText}" />
                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding UpText}" />
                                <ProgressBar
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="3"
                                    Height="2"
                                    Margin="0,6,0,0"
                                    Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Foreground="#185FA5"
                                    Maximum="100"
                                    Value="{Binding SharePercent}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!--  空状态 / 权限说明  -->
            <StackPanel
                Grid.Row="2"
                Padding="0,16"
                VerticalAlignment="Center"
                Spacing="8"
                Visibility="{Binding EmptyVisibility}">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding EmptyText}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </StackPanel>

            <!--  页脚：今日累计  -->
            <TextBlock
                Grid.Row="3"
                Margin="0,8,0,0"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{Binding SessionText}"
                TextWrapping="Wrap" />
        </Grid>
    </Border>
</UserControl>
