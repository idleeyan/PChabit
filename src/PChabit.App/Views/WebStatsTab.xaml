<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="PChabit.App.Views.WebStatsTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:PChabit.App.Controls"
    xmlns:views="using:PChabit.App.Views"
    xmlns:vm="using:PChabit.App.ViewModels"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <ScrollViewer
        x:Name="RootScroll"
        Padding="24"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20">

            <!-- 日期范围快捷按钮 -->
            <Grid>
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Text="网页访问详情" />

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Padding="12,6"
                        Click="Today_Click"
                        Content="今天" />
                    <Button
                        Padding="12,6"
                        Click="Week_Click"
                        Content="近7天" />
                    <Button
                        Padding="12,6"
                        Click="Month_Click"
                        Content="近30天" />
                    <Button
                        Padding="12,6"
                        Click="Refresh_Click"
                        Content="&#xE72C;"
                        FontFamily="Segoe MDL2 Assets"
                        ToolTipService.ToolTip="刷新" />
                </StackPanel>
            </Grid>

            <!-- 日期选择器 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CalendarDatePicker
                    x:Name="StartDatePicker"
                    Header="开始日期"
                    HorizontalAlignment="Stretch" />

                <CalendarDatePicker
                    x:Name="EndDatePicker"
                    Grid.Column="1"
                    Header="结束日期"
                    HorizontalAlignment="Stretch" />

                <Button
                    Grid.Column="2"
                    Margin="0,28,0,0"
                    Padding="16,8"
                    Click="Search_Click"
                    Content="查询" />
            </Grid>

            <!-- 搜索和分类筛选 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="SearchTextBox"
                    PlaceholderText="搜索域名或标题..." />

                <ComboBox
                    x:Name="CategoryComboBox"
                    Grid.Column="1"
                    Header="分类筛选"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="0">
                    <ComboBoxItem Content="全部分类" />
                    <ComboBoxItem Content="搜索" />
                    <ComboBoxItem Content="开发" />
                    <ComboBoxItem Content="视频" />
                    <ComboBoxItem Content="社交" />
                    <ComboBoxItem Content="购物" />
                    <ComboBoxItem Content="邮件" />
                    <ComboBoxItem Content="办公" />
                    <ComboBoxItem Content="新闻" />
                    <ComboBoxItem Content="浏览" />
                </ComboBox>
            </Grid>

            <!-- 统计卡片 -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="总访问次数" />
                        <TextBlock
                            x:Name="TotalVisitsText"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="0" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="总浏览时长" />
                        <TextBlock
                            x:Name="TotalDurationText"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="0分钟" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="独立域名数" />
                        <TextBlock
                            x:Name="UniqueDomainsText"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="0" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="3"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="平均时长" />
                        <TextBlock
                            x:Name="AvgDurationText"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="0秒" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="4"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="活跃时段" />
                        <TextBlock
                            x:Name="PeakHourText"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Text="-" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="5"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="最常访问" />
                        <HyperlinkButton
                            x:Name="TopDomainText"
                            Padding="0"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Content="-"
                            ToolTipService.ToolTip="在浏览器中打开"
                            Click="OpenDomain_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 网站访问排行 + 浏览习惯分析 -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="16">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="网站访问排行" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="访问次数 · 停留时长 · 估算下行流量；右键可设置分类" />

                        <!-- 表头 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="85" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="域名" />
                            <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Text="访问" />
                            <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Text="时长" />
                            <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" Text="下行流量" />
                            <TextBlock Grid.Column="4" FontSize="11" FontWeight="SemiBold" Text="占比" />
                        </Grid>

                        <ListView
                            x:Name="DomainStatsList"
                            ItemsSource="{x:Bind ViewModel.DomainActivity, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="ContextFlyout">
                                        <Setter.Value>
                                            <MenuFlyout Opening="DomainMenu_Opening">
                                                <MenuFlyoutItem Text="设置分类…" IsEnabled="False" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem x:Name="ClearCategoryMenuItem" Text="清除分类映射" Click="ClearCategory_Click" />
                                                <MenuFlyoutSeparator x:Name="CategoryMenuSep" />
                                            </MenuFlyout>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
<Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="85" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="2">
                                            <HyperlinkButton
                                                Padding="0"
                                                FontSize="14"
                                                FontWeight="Medium"
                                                Content="{Binding Domain}"
                                                Tag="{Binding Domain}"
                                                ToolTipService.ToolTip="在浏览器中打开"
                                                Click="OpenDomain_Click" />
                                            <Border
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                CornerRadius="4">
                                                <TextBlock
                                                    FontSize="11"
                                                    Text="{Binding Category}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{Binding VisitCount}" />

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding DurationText}" />

                                        <TextBlock
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding DownText}"
                                            ToolTipService.ToolTip="该域名的估算下行流量" />

                                        <TextBlock
                                            Grid.Column="4"
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{Binding ShareText}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="流量为估算口径：仅统计 Chrome/Edge/Firefox 进程下行流量，按同小时各域名有效浏览时长比例拆分；未含其他浏览器与系统流量，仅供参考"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Spacing="16">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="浏览习惯分析" />

                        <ItemsControl x:Name="BrowsingPatternsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,12"
                                        Padding="12"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8">
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="Medium"
                                                Text="{Binding Pattern}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                MaxLines="2"
                                                Text="{Binding Description}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 活动时间分布（小时分布 + 最近访问记录，3.39.0 合并） -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="活动时间分布" />
                            <TextBlock
                                x:Name="DailySummaryText"
                                VerticalAlignment="Bottom"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="按所选时间段统计 · 左：应用使用与网页浏览的小时活动；右：最近访问记录" />
                    </StackPanel>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 小时分布 -->
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="小时分布" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontSize="11" FontWeight="SemiBold" Text="时段" />
                                <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Text="合计" />
                                <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Text="应用" />
                                <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" Text="网页" />
                                <TextBlock Grid.Column="4" FontSize="11" FontWeight="SemiBold" Text="访问" />
                            </Grid>

                            <ListView
                                ItemsSource="{x:Bind ViewModel.HourlyCombined, Mode=OneWay}"
                                MaxHeight="300"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid
                                            Padding="0,2"
                                            ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="56" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="52" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Text="{Binding HourLabel}" />

                                            <ProgressBar
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Value="{Binding TotalMinutes}" />

                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding AppText}" />

                                            <TextBlock
                                                Grid.Column="3"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding WebText}" />

                                            <TextBlock
                                                Grid.Column="4"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding VisitText}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <!-- 最近访问记录 -->
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="最近访问记录" />

                            <ListView
                                x:Name="RecentVisitsList"
                                SelectionMode="None"
                                MaxHeight="300">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,4"
                                            Padding="12"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="80" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Spacing="4">
                                                    <Grid>
                                                        <TextBlock
                                                            FontWeight="Medium"
                                                            MaxLines="1"
                                                            Text="{Binding Title}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <Border
                                                            Padding="6,2"
                                                            HorizontalAlignment="Right"
                                                            CornerRadius="4"
                                                            Background="{Binding CategoryColor, Converter={StaticResource StringToBrushConverter}}">
                                                            <TextBlock
                                                                FontSize="11"
                                                                Text="{Binding Category}" />
                                                        </Border>
                                                    </Grid>
                                                    <HyperlinkButton
                                                        Padding="0"
                                                        FontSize="12"
                                                        Content="{Binding Domain}"
                                                        Tag="{Binding Url}"
                                                        ToolTipService.ToolTip="在浏览器中打开"
                                                        Click="OpenDomain_Click" />
                                                </StackPanel>

                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding VisitTime}" />

                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding Duration}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Button
                                x:Name="LoadMoreButton"
                                HorizontalAlignment="Center"
                                Click="LoadMore_Click"
                                Content="加载更多"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3.36.0：原「网页浏览历史」独立页签（WebView2 报告）原生化后并入本页 -->
            <views:WebHistorySection x:Name="HistorySection" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
