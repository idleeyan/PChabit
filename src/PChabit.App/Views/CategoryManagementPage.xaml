<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="PChabit.App.Views.CategoryManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:PChabit.App.Views"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="24,24,24,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Spacing="4">
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="分类管理" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="统一管理应用分类与网站分类，两类各自独立维护进程名 / 域名映射规则。" />
            </StackPanel>
        </Border>

        <!--
            注意：不要用 ScrollViewer 包裹两个 Tab——外层 ScrollViewer 会给内部 ListView
            无限高度（禁用其自身滚动），内容超出窗口时底部被截断。
            Pivot 内容区按内容测量高度，UserControl 默认不拉伸，这里把内容 Grid 高度
            绑定到 Pivot 可视高度，恢复 ListView 自身滚动。
        -->
        <Pivot
            x:Name="MainPivot"
            Grid.Row="1"
            Padding="24,12,24,24">
            <PivotItem Header="应用分类">
                <Grid Height="{Binding ActualHeight, ElementName=MainPivot}">
                    <views:CategoryManagementTab />
                </Grid>
            </PivotItem>
            <PivotItem Header="网站分类">
                <Grid Height="{Binding ActualHeight, ElementName=MainPivot}">
                    <views:WebsiteCategoryTab />
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
