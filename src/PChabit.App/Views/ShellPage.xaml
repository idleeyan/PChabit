<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="PChabit.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <NavigationView
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            ItemInvoked="NavView_ItemInvoked"
            PaneDisplayMode="Left"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

            <!-- 导航头部 -->
            <NavigationView.PaneHeader>
                <StackPanel
                    Padding="16,20"
                    Spacing="8">
                    <Image
                        Width="48"
                        Height="48"
                        Source="ms-appx:///Assets/Logo.png"
                        Stretch="Uniform" />
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryBrush}"
                        Text="PChabit" />
                </StackPanel>
            </NavigationView.PaneHeader>

            <!-- 导航菜单项 -->
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="仪表盘"
                    Tag="Dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="时间线"
                    Tag="Timeline">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="应用统计"
                    Tag="AppStats">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="键鼠详情"
                    Tag="KeyboardDetails">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE92E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="网页访问"
                    Tag="WebAccess">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- 分析 -->
                <NavigationViewItem
                    Content="硬件监控"
                    Tag="Monitor">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE950;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <!-- 分析 -->
                <NavigationViewItem
                    Content="分析"
                    Tag="Analytics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="数据管理"
                    Tag="DataManagement">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE88E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    Content="历史分析"
                    Tag="HistoryReport">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- 侧栏下方：全局操作日志（设置按钮上方，跨页面滚动常驻） -->
            <NavigationView.PaneFooter>
                <Border
                    Margin="8,0,8,8"
                    Padding="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="6">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Glyph="&#xE9D5;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Text="全局日志" />
                            </StackPanel>
                            <StackPanel
                                HorizontalAlignment="Right"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Button
                                    x:Name="ToggleGlobalLogButton"
                                    Padding="6,2"
                                    FontSize="11"
                                    Content="收起"
                                    Click="ToggleGlobalLog_Click" />
                                <Button
                                    Padding="6,2"
                                    FontSize="11"
                                    Content="清空"
                                    Click="ClearGlobalLog_Click" />
                            </StackPanel>
                        </Grid>
                        <ListView
                            x:Name="GlobalLogList"
                            MaxHeight="168"
                            SelectionMode="None"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontSize="11"
                                        LineHeight="16"
                                        TextWrapping="Wrap"
                                        Text="{Binding}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </NavigationView.PaneFooter>

            <!-- 内容区域 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Frame x:Name="ContentFrame" Grid.Row="0" />

                <!-- 状态栏 -->
                <Border
                    x:Name="StatusBar"
                    Grid.Row="1"
                    Background="{ThemeResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Ellipse
                                    x:Name="StatusIndicator"
                                    Width="10"
                                    Height="10"
                                    Fill="{StaticResource SuccessBrush}" />
                                <TextBlock
                                    x:Name="StatusText"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Text="监控中" />
                            </StackPanel>

                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="今日活跃: 5小时 32分钟" />
                        </StackPanel>

                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="ToggleMonitorButton"
                                Padding="12,6"
                                VerticalAlignment="Center"
                                Click="ToggleMonitorButton_Click"
                                Content="暂停监控"
                                CornerRadius="6"
                                FontSize="12"
                                Background="{StaticResource WarningBrush}"
                                Foreground="White" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </NavigationView>
    </Grid>
</Page>

