<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="PChabit.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:PChabit.App.Views.Settings"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧分区导航：设置项较多，按分组切换，避免一页长滚找选项 -->
        <Border
            Grid.Column="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
            <ListView
                x:Name="SectionList"
                Padding="8,24,8,8"
                SelectionMode="Single"
                SelectionChanged="SectionList_SelectionChanged">
                <!-- 注意：不要在这里写 IsSelected="True"——XAML 解析到此项时会立刻触发
                     SelectionChanged，而右侧的分区 Border 尚未创建（x:Name 字段还是 null），
                     会直接 NullReferenceException 并冒泡成 XamlParseException。
                     选中项改在构造函数里于 InitializeComponent 之后设置。 -->
                <ListViewItem Content="常规" Tag="general" />
                <ListViewItem Content="监控" Tag="monitor" />
                <ListViewItem Content="界面" Tag="interface" />
                <ListViewItem Content="便签" Tag="notes" />
                <ListViewItem Content="数据" Tag="data" />
                <ListViewItem Content="AI" Tag="ai" />
                <ListViewItem Content="关于" Tag="about" />
            </ListView>
        </Border>

        <ScrollViewer Grid.Column="1" Padding="32,24">
        <StackPanel Spacing="24">

            <!-- 页面标题 -->
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryBrush}"
                Text="设置" />

            <!-- ======================================== -->
            <!-- 基本设置                                    -->
            <!-- ======================================== -->
            <settings:GeneralSettingsSection x:Name="GeneralControl" />

            <!-- ======================================== -->
            <!-- 监控设置                                    -->
            <!-- ======================================== -->
            <settings:MonitorSettingsSection x:Name="MonitorControl" />

            <!-- ======================================== -->
            <!-- ======================================== -->
            <!-- 任务栏与托盘                                    -->
            <!-- ======================================== -->
            <settings:TaskbarSettingsSection x:Name="TaskbarControl" />

            <!-- ======================================== -->
            <!-- 桌面悬浮插件（3.23.0）                          -->
            <!-- ======================================== -->
            <settings:DesktopWidgetSettingsSection x:Name="DesktopWidgetControl" />

            <settings:StickyNotesSection x:Name="StickyNotesControl" />

            <!-- 外观设置                                    -->
            <!-- ======================================== -->
            <settings:AppearanceSettingsSection x:Name="AppearanceControl" />

            <!-- ======================================== -->
            <!-- 数据管理                                    -->
            <!-- ======================================== -->
            <settings:DataSettingsSection x:Name="DataControl" />

            <settings:AiSettingsSection x:Name="AiSectionControl" />

            <settings:AboutSettingsSection x:Name="AboutSectionControl" />
        </StackPanel>
            </ScrollViewer>
    </Grid>
</Page>






