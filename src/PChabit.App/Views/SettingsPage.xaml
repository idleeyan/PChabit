<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="PChabit.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:settings="using:PChabit.App.Views.Settings"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧分区导航：设置项较多，按分组切换，避免一页长滚找选项 -->
        <Border
            Grid.Column="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
            <ListView
                x:Name="SectionList"
                Padding="8,24,8,8"
                SelectionMode="Single"
                SelectionChanged="SectionList_SelectionChanged">
                <!-- 注意：不要在这里写 IsSelected="True"——XAML 解析到此项时会立刻触发
                     SelectionChanged，而右侧的分区 Border 尚未创建（x:Name 字段还是 null），
                     会直接 NullReferenceException 并冒泡成 XamlParseException。
                     选中项改在构造函数里于 InitializeComponent 之后设置。 -->
                <ListViewItem Content="常规" Tag="general" />
                <ListViewItem Content="监控" Tag="monitor" />
                <ListViewItem Content="界面" Tag="interface" />
                <ListViewItem Content="便签" Tag="notes" />
                <ListViewItem Content="数据" Tag="data" />
                <ListViewItem Content="AI" Tag="ai" />
                <ListViewItem Content="关于" Tag="about" />
            </ListView>
        </Border>

        <ScrollViewer Grid.Column="1" Padding="32,24">
        <StackPanel Spacing="24">

            <!-- 页面标题 -->
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryBrush}"
                Text="设置" />

            <!-- ======================================== -->
            <!-- 基本设置                                    -->
            <!-- ======================================== -->
            <Border x:Name="GeneralSection" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <!-- 分组标题 -->
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border
                                Width="32"
                                Height="32"
                                Background="{StaticResource PrimarySoftBrush}"
                                CornerRadius="6">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Glyph="&#xE713;" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="基本设置" />
                        </StackPanel>
                        <TextBlock
                            Margin="44,0,0,0"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="这些设置控制应用程序的启动和显示行为"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border
                        Margin="44,0,0,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="16,4">
                        <StackPanel Spacing="0">
                            <ToggleSwitch
                                x:Name="StartWithWindowsSwitch"
                                Header="开机自启动"
                                IsOn="True" />
                            <ToggleSwitch
                                x:Name="MinimizeToTraySwitch"
                                Header="最小化到系统托盘" />
                            <ToggleSwitch
                                x:Name="ShowNotificationsSwitch"
                                Header="显示通知" />
                            <ToggleSwitch
                                x:Name="AutoStartMonitoringSwitch"
                                Header="自动开始监控" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ======================================== -->
            <!-- 监控设置                                    -->
            <!-- ======================================== -->
            <Border x:Name="MonitorSection" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border
                                Width="32"
                                Height="32"
                                Background="{StaticResource SuccessSoftBrush}"
                                CornerRadius="6">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource SuccessBrush}"
                                    Glyph="&#xE8D1;" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="监控设置" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Margin="44,0,0,0" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="监控间隔 (分钟)" />
                            <NumberBox
                                x:Name="MonitoringIntervalBox"
                                Maximum="60"
                                Minimum="1" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="空闲阈值 (分钟)" />
                            <NumberBox
                                x:Name="IdleThresholdBox"
                                Maximum="60"
                                Minimum="1" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="44,0,0,0" Spacing="4">
                        <TextBlock FontWeight="Medium" Text="数据采集" />
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Margin="0,8,0,0"
                            Padding="16,4">
                            <StackPanel>
                                <ToggleSwitch
                                    x:Name="TrackKeyboardSwitch"
                                    Header="记录键盘输入" />
                                <ToggleSwitch
                                    x:Name="TrackMouseSwitch"
                                    Header="记录鼠标活动" />
                                <ToggleSwitch
                                    x:Name="TrackWebBrowsingSwitch"
                                    Header="记录网页浏览" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ======================================== -->
            <!-- ======================================== -->
            <!-- 任务栏与托盘                                    -->
            <!-- ======================================== -->
            <Border x:Name="TaskbarSection" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border
                                Width="32"
                                Height="32"
                                Background="{StaticResource WarningSoftBrush}"
                                CornerRadius="6">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource WarningBrush}"
                                    Glyph="&#xE792;" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="任务栏与托盘" />
                        </StackPanel>
                        <TextBlock
                            Margin="44,0,0,0"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="在任务栏上显示实时硬件信息"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="44,0,0,0" Spacing="4">
                        <TextBlock FontWeight="Medium" Text="任务栏显示" />
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Margin="0,8,0,0"
                            Padding="16,4">
                            <StackPanel>
                                <ToggleSwitch
                                    x:Name="TaskbarEnabledSwitch"
                                    Header="在任务栏左侧显示两行实时信息"
                                    OffContent="关闭"
                                    OnContent="开启" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="信息显示在任务栏最左侧（与左边缘对齐），勾选下方项目选择显示内容"
                                    TextWrapping="Wrap" />
                                <Grid Margin="0,12,0,0" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ToggleSwitch x:Name="TaskbarCpuSwitch" Header="CPU 占用" />
                                        <ToggleSwitch x:Name="TaskbarMemorySwitch" Header="内存占用" />
                                        <ToggleSwitch x:Name="TaskbarGpuSwitch" Header="GPU 占用" />
                                        <ToggleSwitch x:Name="TaskbarNetSwitch" Header="网速" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <ToggleSwitch x:Name="TaskbarDiskSwitch" Header="磁盘活动" />
                                        <ToggleSwitch x:Name="TaskbarTempSwitch" Header="温度" />
                                        <ToggleSwitch x:Name="TaskbarUsageSwitch" Header="今日使用统计" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="显示项目：CPU/内存/GPU（含显存）第一行，网速/磁盘/温度/今日第二行"
                                    TextWrapping="Wrap" />
                                <StackPanel Margin="0,12,0,0" Spacing="8">
                                    <TextBlock Text="每日目标 (小时)" />
                                    <NumberBox
                                        x:Name="DailyUsageGoalHoursBox"
                                        Minimum="0.5"
                                        Maximum="24"
                                        SmallChange="0.5"
                                        SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ======================================== -->
            <!-- 桌面悬浮插件（3.23.0）                          -->
            <!-- ======================================== -->
            <Border x:Name="DesktopWidgetSection" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border
                                Width="32"
                                Height="32"
                                Background="{StaticResource PrimarySoftBrush}"
                                CornerRadius="6">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Glyph="&#xE95B;" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="桌面悬浮插件" />
                        </StackPanel>
                        <TextBlock
                            Margin="44,0,0,0"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="桌面独立悬浮窗实时显示硬件信息，可拖动、可置顶，双击打开硬件监控页"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="44,0,0,0" Spacing="4">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="16,4">
                            <StackPanel>
                                <ToggleSwitch
                                    x:Name="DesktopWidgetEnabledSwitch"
                                    Header="在桌面显示硬件信息悬浮窗"
                                    OffContent="关闭"
                                    OnContent="开启" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="每秒刷新；拖动可改变位置，位置与所在屏幕自动记忆；最小化到托盘时悬浮窗仍然显示"
                                    TextWrapping="Wrap" />
                                <Grid Margin="0,12,0,0" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ToggleSwitch x:Name="DesktopCpuSwitch" Header="CPU（含温度）" />
                                        <ToggleSwitch x:Name="DesktopMemorySwitch" Header="内存占用" />
                                        <ToggleSwitch x:Name="DesktopGpuSwitch" Header="GPU（含温度）" />
                                        <ToggleSwitch x:Name="DesktopVramSwitch" Header="显存占用" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <ToggleSwitch x:Name="DesktopNetSwitch" Header="网速" />
                                        <ToggleSwitch x:Name="DesktopDiskSwitch" Header="磁盘活动" />
                                        <ToggleSwitch x:Name="DesktopUsageSwitch" Header="今日使用统计" />
                                        <ToggleSwitch x:Name="DesktopCurrentAppSwitch" Header="当前活动" />
                                    </StackPanel>
                                </Grid>
                                <ToggleSwitch
                                    x:Name="DesktopTopmostSwitch"
                                    Header="窗口始终置顶"
                                    Margin="0,12,0,0" />
                                <ToggleSwitch
                                    x:Name="DesktopClickThroughSwitch"
                                    Header="鼠标点击穿透"
                                    Margin="0,4,0,0" />
                                <TextBlock
                                    Margin="0,0,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="开启穿透后鼠标事件将直接穿过悬浮窗，将无法拖动或双击，请先把窗口拖到目标位置"
                                    TextWrapping="Wrap" />
                                <ToggleSwitch
                                    x:Name="DesktopClampSwitch"
                                    Header="限制窗口完全拖出屏幕"
                                    Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 便签（3.24.0）                             -->
            <!-- ======================================== -->
            <Border x:Name="StickyNotesSection" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border
                                Width="32"
                                Height="32"
                                Background="{StaticResource PrimarySoftBrush}"
                                CornerRadius="6">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Glyph="&#xED15;" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="便签" />
                        </StackPanel>
                        <TextBlock
                            Margin="44,0,0,0"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="随时记录想法：全局热键呼出快速录入窗，内容保存在本地并可通过 WebDAV 在多台设备间同步"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="44,0,0,0" Spacing="4">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="16,4">
                            <StackPanel>
                                <ToggleSwitch
                                    x:Name="StickyEnabledSwitch"
                                    Header="启用便签与全局热键"
                                    OffContent="关闭"
                                    OnContent="开启" />

                                <Grid Margin="0,8,0,0" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock FontSize="13" Text="新建便签热键" />
                                        <TextBox
                                            x:Name="StickyHotkeyNewBox"
                                            LostFocus="StickyHotkeyBox_LostFocus"
                                            PlaceholderText="如 Ctrl+Alt+N" />
                                        <TextBlock
                                            x:Name="StickyHotkeyNewError"
                                            FontSize="11"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock FontSize="13" Text="便签列表热键" />
                                        <TextBox
                                            x:Name="StickyHotkeyBoardBox"
                                            LostFocus="StickyHotkeyBox_LostFocus"
                                            PlaceholderText="如 Ctrl+Alt+B" />
                                        <TextBlock
                                            x:Name="StickyHotkeyBoardError"
                                            FontSize="11"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="格式：Ctrl/Alt/Shift/Win 中至少一个 + 字母/数字/F1-F12，如 Ctrl+Alt+N；清空则不注册该热键"
                                    TextWrapping="Wrap" />

                                <ToggleSwitch
                                    x:Name="StickyQuickDismissSwitch"
                                    Header="快速录入窗失焦 1.5 秒后自动保存"
                                    Margin="0,8,0,0" />

                                <Grid Margin="0,8,0,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox
                                        x:Name="StickyRetentionBox"
                                        Grid.Column="0"
                                        Header="回收站保留天数"
                                        LargeChange="10"
                                        Maximum="3650"
                                        Minimum="1"
                                        SpinButtonPlacementMode="Inline"
                                        Value="30"
                                        Width="160" />
                                </Grid>

                                <Border
                                    Margin="0,12,0,4"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,12,0,4">
                                    <StackPanel Spacing="8">
                                        <ToggleSwitch
                                            x:Name="StickySyncSwitch"
                                            Header="通过 WebDAV 同步便签"
                                            OffContent="关闭"
                                            OnContent="开启" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="多设备按最后修改时间合并；同一条便签两端都修改时保留双方内容并标记冲突。需先在「数据同步」中开启并配置 WebDAV。"
                                            TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Button
                                                x:Name="StickySyncNowButton"
                                                Click="StickySyncNow_Click"
                                                Content="立即同步" />
                                            <TextBlock
                                                x:Name="StickyLastSyncText"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="从未同步" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 外观设置                                    -->
            <!-- ======================================== -->
            <Border x:Name="AppearanceSection" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border
                            Width="32"
                            Height="32"
                            Background="{StaticResource InsightSoftBrush}"
                            CornerRadius="6">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{StaticResource InsightBrush}"
                                Glyph="&#xE790;" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="外观" />
                    </StackPanel>

                    <Grid Margin="44,0,0,0" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="主题" />
                            <ComboBox x:Name="ThemeComboBox" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="语言" />
                            <ComboBox x:Name="LanguageComboBox" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ======================================== -->
            <!-- 数据管理                                    -->
            <!-- ======================================== -->
            <Border x:Name="DataSection" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border
                                Width="32"
                                Height="32"
                                Background="{StaticResource PrimarySoftBrush}"
                                CornerRadius="6">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Glyph="&#xE74D;" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="数据管理" />
                        </StackPanel>
                        <TextBlock
                            Margin="44,0,0,0"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="配置数据保留和自动清理策略，DailySummary 预聚合数据不会被清理"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="44,0,0,0" Spacing="16">
                        <!-- 自动清理开关 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Text="自动清理旧数据" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="启用后自动删除超过保留天数的原始事件数据" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                IsOn="{x:Bind ViewModel.AutoCleanupEnabled, Mode=TwoWay}" />
                        </Grid>

                        <!-- 保留天数 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Text="数据保留天数" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="超过此天数的原始事件数据将被清理（30-365 天）" />
                            </StackPanel>
                            <NumberBox
                                Grid.Column="1"
                                Width="120"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Maximum="365"
                                Minimum="30"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.DataRetentionDays, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <settings:AiSettingsSection x:Name="AiSectionControl" />

            <settings:AboutSettingsSection x:Name="AboutSectionControl" />
        </StackPanel>
            </ScrollViewer>
    </Grid>
</Page>


