<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="PChabit.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
    mc:Ignorable="d">

    <ScrollViewer Padding="32,24">
        <StackPanel Spacing="24">

            <!-- 页面标题 -->
            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="{StaticResource PrimaryBrush}"
                Text="设置" />

            <!-- ======================================== -->
            <!-- 基本设置                                    -->
            <!-- ======================================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <!-- 分组标题 -->
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border
                                Width="32"
                                Height="32"
                                Background="{StaticResource PrimarySoftBrush}"
                                CornerRadius="6">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Glyph="&#xE713;" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="基本设置" />
                        </StackPanel>
                        <TextBlock
                            Margin="44,0,0,0"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="这些设置控制应用程序的启动和显示行为"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border
                        Margin="44,0,0,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="16,4">
                        <StackPanel Spacing="0">
                            <ToggleSwitch
                                x:Name="StartWithWindowsSwitch"
                                Header="开机自启动"
                                IsOn="True" />
                            <ToggleSwitch
                                x:Name="MinimizeToTraySwitch"
                                Header="最小化到系统托盘" />
                            <ToggleSwitch
                                x:Name="ShowNotificationsSwitch"
                                Header="显示通知" />
                            <ToggleSwitch
                                x:Name="AutoStartMonitoringSwitch"
                                Header="自动开始监控" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ======================================== -->
            <!-- 监控设置                                    -->
            <!-- ======================================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border
                                Width="32"
                                Height="32"
                                Background="{StaticResource SuccessSoftBrush}"
                                CornerRadius="6">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource SuccessBrush}"
                                    Glyph="&#xE8D1;" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="监控设置" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Margin="44,0,0,0" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="监控间隔 (分钟)" />
                            <NumberBox
                                x:Name="MonitoringIntervalBox"
                                Maximum="60"
                                Minimum="1" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="空闲阈值 (分钟)" />
                            <NumberBox
                                x:Name="IdleThresholdBox"
                                Maximum="60"
                                Minimum="1" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="44,0,0,0" Spacing="4">
                        <TextBlock FontWeight="Medium" Text="数据采集" />
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Margin="0,8,0,0"
                            Padding="16,4">
                            <StackPanel>
                                <ToggleSwitch
                                    x:Name="TrackKeyboardSwitch"
                                    Header="记录键盘输入" />
                                <ToggleSwitch
                                    x:Name="TrackMouseSwitch"
                                    Header="记录鼠标活动" />
                                <ToggleSwitch
                                    x:Name="TrackWebBrowsingSwitch"
                                    Header="记录网页浏览" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ======================================== -->
            <!-- ======================================== -->
            <!-- 任务栏与托盘                                    -->
            <!-- ======================================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border
                                Width="32"
                                Height="32"
                                Background="{StaticResource WarningSoftBrush}"
                                CornerRadius="6">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource WarningBrush}"
                                    Glyph="&#xE792;" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="任务栏与托盘" />
                        </StackPanel>
                        <TextBlock
                            Margin="44,0,0,0"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="在任务栏上显示实时硬件信息"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="44,0,0,0" Spacing="4">
                        <TextBlock FontWeight="Medium" Text="任务栏显示" />
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Margin="0,8,0,0"
                            Padding="16,4">
                            <StackPanel>
                                <ToggleSwitch
                                    x:Name="TaskbarEnabledSwitch"
                                    Header="在任务栏左侧显示两行实时信息"
                                    OffContent="关闭"
                                    OnContent="开启" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="信息显示在任务栏最左侧（与左边缘对齐），勾选下方项目选择显示内容"
                                    TextWrapping="Wrap" />
                                <Grid Margin="0,12,0,0" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <ToggleSwitch x:Name="TaskbarCpuSwitch" Header="CPU 占用" />
                                        <ToggleSwitch x:Name="TaskbarMemorySwitch" Header="内存占用" />
                                        <ToggleSwitch x:Name="TaskbarGpuSwitch" Header="GPU 占用" />
                                        <ToggleSwitch x:Name="TaskbarNetSwitch" Header="网速" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <ToggleSwitch x:Name="TaskbarDiskSwitch" Header="磁盘活动" />
                                        <ToggleSwitch x:Name="TaskbarTempSwitch" Header="温度" />
                                        <ToggleSwitch x:Name="TaskbarUsageSwitch" Header="今日使用统计" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Margin="0,8,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="显示项目：CPU/内存/GPU（含显存）第一行，网速/磁盘/温度/今日第二行"
                                    TextWrapping="Wrap" />
                                <StackPanel Margin="0,12,0,0" Spacing="8">
                                    <TextBlock Text="每日目标 (小时)" />
                                    <NumberBox
                                        x:Name="DailyUsageGoalHoursBox"
                                        Minimum="0.5"
                                        Maximum="24"
                                        SmallChange="0.5"
                                        SpinButtonPlacementMode="Compact" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 外观设置                                    -->
            <!-- ======================================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border
                            Width="32"
                            Height="32"
                            Background="{StaticResource InsightSoftBrush}"
                            CornerRadius="6">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{StaticResource InsightBrush}"
                                Glyph="&#xE790;" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="外观" />
                    </StackPanel>

                    <Grid Margin="44,0,0,0" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="主题" />
                            <ComboBox x:Name="ThemeComboBox" HorizontalAlignment="Stretch" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="语言" />
                            <ComboBox x:Name="LanguageComboBox" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ======================================== -->
            <!-- 数据管理                                    -->
            <!-- ======================================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border
                                Width="32"
                                Height="32"
                                Background="{StaticResource PrimarySoftBrush}"
                                CornerRadius="6">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Glyph="&#xE74D;" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="数据管理" />
                        </StackPanel>
                        <TextBlock
                            Margin="44,0,0,0"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="配置数据保留和自动清理策略，DailySummary 预聚合数据不会被清理"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="44,0,0,0" Spacing="16">
                        <!-- 自动清理开关 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Text="自动清理旧数据" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="启用后自动删除超过保留天数的原始事件数据" />
                            </StackPanel>
                            <ToggleSwitch
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                IsOn="{x:Bind ViewModel.AutoCleanupEnabled, Mode=TwoWay}" />
                        </Grid>

                        <!-- 保留天数 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="Medium"
                                    Text="数据保留天数" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="超过此天数的原始事件数据将被清理（30-365 天）" />
                            </StackPanel>
                            <NumberBox
                                Grid.Column="1"
                                Width="120"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Maximum="365"
                                Minimum="30"
                                SpinButtonPlacementMode="Inline"
                                Value="{x:Bind ViewModel.DataRetentionDays, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ======================================== -->
            <!-- 分析 AI（可选，默认关闭）                    -->
            <!-- ======================================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border
                                Width="32"
                                Height="32"
                                Background="{StaticResource PrimarySoftBrush}"
                                CornerRadius="6">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Glyph="&#xE945;" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="分析 AI 深度解读" />
                        </StackPanel>
                        <TextBlock
                            Margin="44,0,0,0"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="默认关闭。启用后，分析页可将聚合 KPI/构成/硬件摘要发给你配置的 OpenAI 兼容端点；不上传窗口标题、URL 与完整会话。密钥仅存本机。本地模型请把超时调到 300 秒以上。"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border
                        Margin="44,0,0,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="16,4">
                        <StackPanel Spacing="12">
                            <ToggleSwitch
                                x:Name="AiInsightsEnabledSwitch"
                                Header="启用 AI 深度解读"
                                IsOn="False" />

                            <!-- 端点模式：置顶醒目三选一 -->
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="2"
                                CornerRadius="10"
                                Padding="14,12">
                                <StackPanel Spacing="10">
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="端点模式（必选，易被忽略请先设这里）" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="决定「AI 深度解读 / 追问」走哪套接口。本地 = LM Studio；云端 = API Key。"
                                        TextWrapping="Wrap" />
                                    <RadioButtons
                                        x:Name="AiEndpointModeRadio"
                                        MaxColumns="1">
                                        <RadioButton x:Name="AiModeCloudRadio" Content="云端 — 解读与追问都走云端 API" />
                                        <RadioButton x:Name="AiModeLocalRadio" Content="本地 — 都走 LM Studio（可空 Key）" />
                                        <RadioButton x:Name="AiModeDualRadio" Content="双端点 — 解读云端 · 追问本地（推荐）" />
                                    </RadioButtons>
                                    <TextBlock
                                        x:Name="AiEndpointModeHint"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="当前：云端"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="云端配置（API Key 必填）"
                                TextWrapping="Wrap" />
                            <TextBox
                                x:Name="AiBaseUrlBox"
                                Header="云端 Base URL"
                                PlaceholderText="https://api.deepseek.com 或 https://open.bigmodel.cn/api/paas/v4"
                                Text="" />
                            <TextBox
                                x:Name="AiApiKeyBox"
                                Header="云端 API Key（明文保存）"
                                PlaceholderText="sk-..."
                                Text="" />
                            <TextBox
                                x:Name="AiModelBox"
                                Header="云端模型"
                                PlaceholderText="deepseek-chat / glm-4-flash / gpt-4o-mini"
                                Text="" />
                            <TextBox
                                x:Name="AiModelFastBox"
                                Header="追问快捷模型（可空=同云端模型）"
                                PlaceholderText="留空则与云端模型相同"
                                Text="" />
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="本地配置（LM Studio · Key 可空）"
                                TextWrapping="Wrap" />
                            <TextBox
                                x:Name="AiLocalBaseUrlBox"
                                Header="本地 Base URL"
                                PlaceholderText="http://127.0.0.1:1234/v1"
                                Text="" />
                            <TextBox
                                x:Name="AiLocalModelBox"
                                Header="本地模型"
                                PlaceholderText="与 LM Studio 加载名完全一致"
                                Text="" />

                            <Button
                                x:Name="AiTestButton"
                                HorizontalAlignment="Stretch"
                                Content="保存并测试连接"
                                Click="AiTestConnection_Click" />
                            <Button
                                HorizontalAlignment="Stretch"
                                Content="复制测试结果"
                                Click="AiCopyTestResult_Click" />
                            <TextBox
                                x:Name="AiTestResult"
                                IsReadOnly="True"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="72"
                                PlaceholderText="点「保存并测试连接」后，结果可全选复制" />

                            <ComboBox
                                x:Name="AiProviderBox"
                                Header="Provider 标签（不再自动改写 URL/模型）"
                                HorizontalAlignment="Stretch"
                                SelectedItem="智谱" />
                            <Button
                                HorizontalAlignment="Stretch"
                                Content="按 Provider 填充默认 URL / 模型（会覆盖当前值）"
                                Click="AiFillProviderPreset_Click" />
                            <NumberBox
                                x:Name="AiTimeoutSecondsBox"
                                Header="请求超时（秒）"
                                Minimum="30"
                                Maximum="900"
                                SmallChange="30"
                                LargeChange="60"
                                Value="300" />
                            <ToggleSwitch
                                x:Name="AiStrictPrivacySwitch"
                                Header="严格隐私（出域不含应用/分类名）"
                                IsOn="False" />
                            <ToggleSwitch
                                x:Name="AiAutoWeeklyInsightSwitch"
                                Header="每周自动 AI 解读"
                                IsOn="False" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ======================================== -->
            <!-- 关于卡片                                    -->
            <!-- ======================================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border
                            Width="32"
                            Height="32"
                            Background="{StaticResource PrimarySoftBrush}"
                            CornerRadius="6">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{StaticResource PrimaryBrush}"
                                Glyph="&#xE946;" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="关于" />
                    </StackPanel>

                    <!-- 应用信息头部 -->
                    <Border
                        Margin="44,0,0,0"
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- LOGO 占位 -->
                            <Border
                                Width="64"
                                Height="64"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="12">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="P" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Spacing="4">
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="PChabit" />
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="电脑使用习惯追踪工具" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Spacing="6">
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 信息行 -->
                    <StackPanel Margin="44,0,0,0" Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="版本" />
                            <TextBlock
                                x:Name="VersionText"
                                Grid.Column="1"
                                FontSize="13"
                                FontWeight="Medium" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="构建信息" />
                            <TextBlock
                                x:Name="BuildInfoText"
                                Grid.Column="1"
                                FontSize="13"
                                TextWrapping="Wrap" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="项目地址" />
                            <HyperlinkButton
                                Grid.Column="1"
                                Padding="0"
                                Content="github.com/idleeyan/PChabit"
                                NavigateUri="https://github.com/idleeyan/PChabit" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="技术栈" />
                            <TextBlock
                                x:Name="TechStackText"
                                Grid.Column="1"
                                FontSize="13"
                                TextWrapping="Wrap" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="运行时" />
                            <TextBlock
                                x:Name="RuntimeInfoText"
                                Grid.Column="1"
                                FontSize="13"
                                TextWrapping="Wrap" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="数据目录" />
                            <TextBlock
                                x:Name="DataPathText"
                                Grid.Column="1"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>

                    <!-- 最新更新摘要 -->
                    <Border
                        Margin="44,0,0,0"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Glyph="&#xE8A5;" />
                                <TextBlock
                                    x:Name="LatestChangelogTitleText"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="最新更新" />
                            </StackPanel>
                            <TextBlock
                                x:Name="LatestChangelogBodyText"
                                FontSize="12"
                                LineHeight="18"
                                MaxHeight="120"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                x:Name="ExpandChangelogButton"
                                Padding="8,4"
                                FontSize="12"
                                Content="展开完整日志"
                                Click="OnViewChangelogClick" />
                        </StackPanel>
                    </Border>

                    <!-- 使用说明 -->
                    <Border
                        Margin="44,0,0,0"
                        Padding="16"
                        Background="{StaticResource PrimarySoftBrush}"
                        CornerRadius="8">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Glyph="&#xE946;" />
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Text="使用说明" />
                            </StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                LineHeight="20"
                                Text="PChabit 是一款电脑使用习惯追踪工具，可以记录您的应用程序使用时间、键盘鼠标活动、网页浏览历史等数据，帮助您了解自己的电脑使用习惯。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- 操作按钮 -->
                    <StackPanel
                        Margin="44,0,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="ViewChangelogButton"
                            Click="OnViewChangelogClick"
                            CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontSize="12"
                                    Glyph="&#xE8A5;" />
                                <TextBlock Text="查看更新日志" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
