<?xml version="1.0" encoding="UTF-8" ?>
<ContentDialog
    x:Class="PChabit.App.Views.AppDetailDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    DefaultButton="Close"
    PrimaryButtonText="关闭"
    SecondaryButtonText="复制摘要"
    PrimaryButtonStyle="{StaticResource AccentButtonStyle}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">820</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">680</x:Double>
    </ContentDialog.Resources>

    <!--
        3.45.0 布局修复：原先根节点内是 StackPanel 直接包 ScrollViewer，
        StackPanel 会把「期望高度」（无限）直接给 ScrollViewer，导致内容超出 MaxHeight 后
        既不出滚动条也被裁掉——底部的「日趋势」「常用窗口 Top」等卡片看不到。
        改为 Grid 三行（头部 Auto / 加载态 Auto / 内容区 *），内容区拿到确定高度即可正常滚动。
    -->
    <Grid MinWidth="560" MaxHeight="560">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Bind ViewModel.AppTitle, Mode=OneWay}" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.ProcessText, Mode=OneWay}" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    Text="{x:Bind ViewModel.PeriodText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top">
                <Image
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Right"
                    Source="{x:Bind ViewModel.Icon, Mode=OneWay}"
                    Stretch="UniformToFill" />
                <Border
                    Padding="8,3"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="4">
                    <TextBlock FontSize="12" Text="{x:Bind ViewModel.CategoryText, Mode=OneWay}" />
                </Border>
                <Button
                    Padding="8,4"
                    HorizontalAlignment="Right"
                    Click="ChangeCategory_Click"
                    Content="改分类" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,8" Spacing="8">
            <ProgressRing
                Width="28"
                Height="28"
                HorizontalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <TextBlock
                FontSize="13"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasData, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel Spacing="12">
                <!-- KPI -->
                <Grid ColumnSpacing="8" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Padding="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="总时长" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Padding="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="会话" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind ViewModel.SessionsText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="均长" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind ViewModel.AvgText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Padding="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="占比" />
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{x:Bind ViewModel.ShareText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Padding="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="专注" />
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Bind ViewModel.FocusText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" Padding="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="环比 / 最长" />
                            <TextBlock FontSize="14" FontWeight="SemiBold">
                                <Run Text="{x:Bind ViewModel.DeltaText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind ViewModel.LongestText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 详细说明（3.41.0：预置库 + 用户可编辑；内联编辑避免嵌套 ContentDialog） -->
                <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                    <StackPanel Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="详细说明" />
                                <ProgressRing
                                    Width="14"
                                    Height="14"
                                    IsActive="{x:Bind ViewModel.IsDescriptionLoading, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                x:Name="EditDescriptionButton"
                                Grid.Column="1"
                                Padding="8,3"
                                FontSize="12"
                                Click="EditDescription_Click"
                                Content="编辑说明" />
                            <StackPanel
                                x:Name="EditDescriptionActions"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="Collapsed">
                                <Button
                                    Padding="8,3"
                                    FontSize="12"
                                    Click="SaveDescription_Click"
                                    Content="保存" />
                                <Button
                                    Padding="8,3"
                                    FontSize="12"
                                    Click="CancelEditDescription_Click"
                                    Content="取消" />
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            x:Name="DescriptionText"
                            FontSize="12.5"
                            LineHeight="20"
                            TextWrapping="Wrap"
                            Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasDescription, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock
                            x:Name="DescriptionEmptyText"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="暂无说明，点击「编辑说明」为本应用添加详细介绍。"
                            Visibility="{x:Bind ViewModel.HasDescription, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                        <TextBox
                            x:Name="DescriptionEditor"
                            AcceptsReturn="True"
                            MinHeight="110"
                            MaxHeight="240"
                            PlaceholderText="输入该应用的详细说明（用途、功能特点等）"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- 键鼠统计（3.46.0：原「输入」卡片升级，并入键鼠页「按应用键鼠统计」六项） -->
                <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8"
                        Visibility="{x:Bind ViewModel.HasKeyMouse, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel Spacing="6">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="键鼠统计" ToolTipService.ToolTip="本周期该应用的键盘（按键/KPM）与鼠标（点击/移动/滚动）统计，缺失侧显示 —" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="按键" />
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Bind ViewModel.KeyPressesText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="KPM" />
                                <TextBlock FontSize="14" FontWeight="SemiBold" Text="{x:Bind ViewModel.KeysPerHourText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock FontSize="11" Foreground="#0078D4" Text="点击" />
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#0078D4" Text="{x:Bind ViewModel.MouseClicksText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="2">
                                <TextBlock FontSize="11" Foreground="#8764B8" Text="移动" />
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#8764B8" Text="{x:Bind ViewModel.MouseMoveText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Spacing="2">
                                <TextBlock FontSize="11" Foreground="#00B7C3" Text="滚动" />
                                <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#00B7C3" Text="{x:Bind ViewModel.MouseScrollsText, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8"
                        Visibility="{x:Bind ViewModel.HasHardware, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="硬件（前台重叠）" />
                        <TextBlock FontSize="12" Text="{x:Bind ViewModel.HardwareSummary, Mode=OneWay}" />
                    </StackPanel>
                </Border>

                <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                    <StackPanel Spacing="6">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="小时分布（有使用的时段）" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Hourly, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Width="28"
                                            Margin="0,0,3,0"
                                            Padding="2,4"
                                            CornerRadius="4"
                                            ToolTipService.ToolTip="{Binding MinutesText}">
                                            <Border.Background>
                                                <SolidColorBrush Color="#512BD4" Opacity="{Binding Intensity, Converter={StaticResource HeatLevelToOpacityConverter}}" />
                                            </Border.Background>
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="9"
                                                Text="{Binding Label}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                    <StackPanel Spacing="6">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="日趋势" />
                        <ScrollViewer HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.Days, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,8,0" Spacing="2" Width="44">
                                            <Border Height="48" CornerRadius="3" Background="{ThemeResource ControlFillColorDefaultBrush}">
                                                <Border
                                                    Height="{Binding BarHeight}"
                                                    MaxHeight="48"
                                                    VerticalAlignment="Bottom"
                                                    Background="{StaticResource PrimaryBrush}"
                                                    CornerRadius="3" />
                                            </Border>
                                            <TextBlock HorizontalAlignment="Center" FontSize="9" Text="{Binding DateLabel}" />
                                            <TextBlock HorizontalAlignment="Center" FontSize="9" Text="{Binding MinutesText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <Border Padding="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
                    <StackPanel Spacing="4">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="常用窗口 Top" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.WindowTitles, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontSize="12"
                                        TextWrapping="Wrap"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="窗口标题仅本地展示；复制摘要可包含列表。"
                            Visibility="{x:Bind ViewModel.HasData, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ContentDialog>
