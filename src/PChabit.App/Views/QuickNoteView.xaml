<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="PChabit.App.Views.QuickNoteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" RowDefinitions="*,Auto" Padding="16,14,16,10" CornerRadius="8">
        <TextBox
            x:Name="ContentBox"
            BorderThickness="0"
            Background="Transparent"
            AcceptsReturn="True"
            FontSize="15"
            PlaceholderText="记点什么…（Ctrl+Enter 保存，Esc 稍后再写）"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextWrapping="Wrap"
            TextChanged="ContentBox_TextChanged"
            KeyDown="ContentBox_KeyDown">
            <TextBox.KeyboardAccelerators>
                <!-- CoreWindow 级路由，比 KeyDown 更靠近底层：中文 IME 无组合态时物理 Ctrl+Enter 稳定触发 -->
                <KeyboardAccelerator
                    x:Name="SaveAccelerator"
                    Invoked="SaveAccelerator_Invoked"
                    Key="Enter"
                    Modifiers="Control" />
            </TextBox.KeyboardAccelerators>
        </TextBox>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Border
                    x:Name="DotYellow"
                    Width="18"
                    Height="18"
                    CornerRadius="9"
                    Background="#E8C83A"
                    Tapped="ColorDot_Tapped"
                    Tag="yellow" />
                <Border
                    x:Name="DotPink"
                    Width="18"
                    Height="18"
                    CornerRadius="9"
                    Background="#E88AAE"
                    Tapped="ColorDot_Tapped"
                    Tag="pink" />
                <Border
                    x:Name="DotBlue"
                    Width="18"
                    Height="18"
                    CornerRadius="9"
                    Background="#6FA8DC"
                    Tapped="ColorDot_Tapped"
                    Tag="blue" />
                <Border
                    x:Name="DotGreen"
                    Width="18"
                    Height="18"
                    CornerRadius="9"
                    Background="#7BBF7D"
                    Tapped="ColorDot_Tapped"
                    Tag="green" />
                <Border
                    x:Name="DotGray"
                    Width="18"
                    Height="18"
                    CornerRadius="9"
                    Background="#B0B0B0"
                    Tapped="ColorDot_Tapped"
                    Tag="gray" />
            </StackPanel>

            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                FontSize="11"
                Foreground="#8A7C45"
                Text="Ctrl+Enter 保存 · Esc 隐藏" />
        </Grid>
    </Grid>
</UserControl>
