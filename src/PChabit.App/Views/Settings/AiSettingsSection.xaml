<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="PChabit.App.Views.Settings.AiSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

            <Border x:Name="AiSection" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border
                                Width="32"
                                Height="32"
                                Background="{StaticResource PrimarySoftBrush}"
                                CornerRadius="6">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Glyph="&#xE945;" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="分析 AI 深度解读" />
                        </StackPanel>
                        <TextBlock
                            Margin="44,0,0,0"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="默认关闭。启用后，分析页可将聚合 KPI/构成/硬件摘要发给你配置的 OpenAI 兼容端点；不上传窗口标题、URL 与完整会话。密钥仅存本机。本地模型请把超时调到 300 秒以上。"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border
                        Margin="44,0,0,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="16,4">
                        <StackPanel Spacing="12">
                            <ToggleSwitch
                                x:Name="AiInsightsEnabledSwitch"
                                Header="启用 AI 深度解读"
                                IsOn="False" />

                            <!-- 端点模式：置顶醒目三选一 -->
                            <Border
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="2"
                                CornerRadius="10"
                                Padding="14,12">
                                <StackPanel Spacing="10">
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="端点模式（必选，易被忽略请先设这里）" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="决定「AI 深度解读 / 追问」走哪套接口。本地 = LM Studio；云端 = API Key。"
                                        TextWrapping="Wrap" />
                                    <RadioButtons
                                        x:Name="AiEndpointModeRadio"
                                        MaxColumns="1">
                                        <RadioButton x:Name="AiModeCloudRadio" Content="云端 — 解读与追问都走云端 API" />
                                        <RadioButton x:Name="AiModeLocalRadio" Content="本地 — 都走 LM Studio（可空 Key）" />
                                        <RadioButton x:Name="AiModeDualRadio" Content="双端点 — 解读云端 · 追问本地（推荐）" />
                                    </RadioButtons>
                                    <TextBlock
                                        x:Name="AiEndpointModeHint"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Text="当前：云端"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="云端配置（API Key 必填）"
                                TextWrapping="Wrap" />
                            <TextBox
                                x:Name="AiBaseUrlBox"
                                Header="云端 Base URL"
                                PlaceholderText="https://api.deepseek.com 或 https://open.bigmodel.cn/api/paas/v4"
                                Text="" />
                            <TextBox
                                x:Name="AiApiKeyBox"
                                Header="云端 API Key（明文保存）"
                                PlaceholderText="sk-..."
                                Text="" />
                            <TextBox
                                x:Name="AiModelBox"
                                Header="云端模型"
                                PlaceholderText="deepseek-chat / glm-4-flash / gpt-4o-mini"
                                Text="" />
                            <TextBox
                                x:Name="AiModelFastBox"
                                Header="追问快捷模型（可空=同云端模型）"
                                PlaceholderText="留空则与云端模型相同"
                                Text="" />
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="本地配置（LM Studio · Key 可空）"
                                TextWrapping="Wrap" />
                            <TextBox
                                x:Name="AiLocalBaseUrlBox"
                                Header="本地 Base URL"
                                PlaceholderText="http://127.0.0.1:1234/v1"
                                Text="" />
                            <TextBox
                                x:Name="AiLocalModelBox"
                                Header="本地模型"
                                PlaceholderText="与 LM Studio 加载名完全一致"
                                Text="" />

                            <Button
                                x:Name="AiTestButton"
                                HorizontalAlignment="Stretch"
                                Content="保存并测试连接"
                                Click="AiTestConnection_Click" />
                            <Button
                                HorizontalAlignment="Stretch"
                                Content="复制测试结果"
                                Click="AiCopyTestResult_Click" />
                            <TextBox
                                x:Name="AiTestResult"
                                IsReadOnly="True"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                MinHeight="72"
                                PlaceholderText="点「保存并测试连接」后，结果可全选复制" />

                            <NumberBox
                                x:Name="AiTimeoutSecondsBox"
                                Header="请求超时（秒）"
                                Minimum="30"
                                Maximum="900"
                                SmallChange="30"
                                LargeChange="60"
                                Value="300" />
                            <ToggleSwitch
                                x:Name="AiStrictPrivacySwitch"
                                Header="严格隐私（出域不含应用/分类名）"
                                IsOn="False" />
                            <ToggleSwitch
                                x:Name="AiAutoWeeklyInsightSwitch"
                                Header="每周自动 AI 解读"
                                IsOn="False" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
</UserControl>
