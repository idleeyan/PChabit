<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="PChabit.App.Views.Settings.AboutSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

            <Border x:Name="AboutSection" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border
                            Width="32"
                            Height="32"
                            Background="{StaticResource PrimarySoftBrush}"
                            CornerRadius="6">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{StaticResource PrimaryBrush}"
                                Glyph="&#xE946;" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="关于" />
                    </StackPanel>

                    <!-- 应用信息头部 -->
                    <Border
                        Margin="44,0,0,0"
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- LOGO 占位 -->
                            <Border
                                Width="64"
                                Height="64"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="12">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="P" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                Spacing="4">
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Text="PChabit" />
                                <TextBlock
                                    FontSize="13"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="电脑使用习惯追踪工具" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Spacing="6">
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 信息行 -->
                    <StackPanel Margin="44,0,0,0" Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="版本" />
                            <TextBlock
                                x:Name="VersionText"
                                Grid.Column="1"
                                FontSize="13"
                                FontWeight="Medium" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="构建信息" />
                            <TextBlock
                                x:Name="BuildInfoText"
                                Grid.Column="1"
                                FontSize="13"
                                TextWrapping="Wrap" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="项目地址" />
                            <HyperlinkButton
                                Grid.Column="1"
                                Padding="0"
                                Content="github.com/idleeyan/PChabit"
                                NavigateUri="https://github.com/idleeyan/PChabit" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="技术栈" />
                            <TextBlock
                                x:Name="TechStackText"
                                Grid.Column="1"
                                FontSize="13"
                                TextWrapping="Wrap" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="运行时" />
                            <TextBlock
                                x:Name="RuntimeInfoText"
                                Grid.Column="1"
                                FontSize="13"
                                TextWrapping="Wrap" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                FontSize="13"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="数据目录" />
                            <TextBlock
                                x:Name="DataPathText"
                                Grid.Column="1"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </StackPanel>

                    <!-- 最新更新摘要 -->
                    <Border
                        Margin="44,0,0,0"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Glyph="&#xE8A5;" />
                                <TextBlock
                                    x:Name="LatestChangelogTitleText"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Text="最新更新" />
                            </StackPanel>
                            <TextBlock
                                x:Name="LatestChangelogBodyText"
                                FontSize="12"
                                LineHeight="18"
                                MaxHeight="120"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                x:Name="ExpandChangelogButton"
                                Padding="8,4"
                                FontSize="12"
                                Content="展开完整日志"
                                Click="OnViewChangelogClick" />
                        </StackPanel>
                    </Border>

                    <!-- 使用说明 -->
                    <Border
                        Margin="44,0,0,0"
                        Padding="16"
                        Background="{StaticResource PrimarySoftBrush}"
                        CornerRadius="8">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontSize="14"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Glyph="&#xE946;" />
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Text="使用说明" />
                            </StackPanel>
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                LineHeight="20"
                                Text="PChabit 是一款电脑使用习惯追踪工具，可以记录您的应用程序使用时间、键盘鼠标活动、网页浏览历史等数据，帮助您了解自己的电脑使用习惯。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- 操作按钮 -->
                    <StackPanel
                        Margin="44,0,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="ViewChangelogButton"
                            Click="OnViewChangelogClick"
                            CornerRadius="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon
                                    FontSize="12"
                                    Glyph="&#xE8A5;" />
                                <TextBlock Text="查看更新日志" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
</UserControl>
