<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="PChabit.App.Views.Settings.MonitorSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

            <Border x:Name="MonitorSection" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border
                                Width="32"
                                Height="32"
                                Background="{StaticResource SuccessSoftBrush}"
                                CornerRadius="6">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource SuccessBrush}"
                                    Glyph="&#xE8D1;" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="监控设置" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Margin="44,0,0,0" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="监控间隔 (分钟)" />
                            <NumberBox
                                x:Name="MonitoringIntervalBox"
                                Maximum="60"
                                Minimum="1" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock Text="空闲阈值 (分钟)" />
                            <NumberBox
                                x:Name="IdleThresholdBox"
                                Maximum="60"
                                Minimum="1" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="44,0,0,0" Spacing="4">
                        <TextBlock FontWeight="Medium" Text="数据采集" />
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Margin="0,8,0,0"
                            Padding="16,4">
                            <StackPanel>
                                <ToggleSwitch
                                    x:Name="TrackKeyboardSwitch"
                                    Header="记录键盘输入" />
                                <ToggleSwitch
                                    x:Name="TrackMouseSwitch"
                                    Header="记录鼠标活动" />
                                <ToggleSwitch
                                    x:Name="TrackWebBrowsingSwitch"
                                    Header="记录网页浏览" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
</UserControl>
