<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="PChabit.App.Views.Settings.StickyNotesSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

            <!-- 便签（3.24.0）                             -->
            <!-- ======================================== -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border
                                Width="32"
                                Height="32"
                                Background="{StaticResource PrimarySoftBrush}"
                                CornerRadius="6">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Glyph="&#xED15;" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="便签" />
                        </StackPanel>
                        <TextBlock
                            Margin="44,0,0,0"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="随时记录想法：全局热键呼出快速录入窗，内容保存在本地并可通过 WebDAV 在多台设备间同步"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="44,0,0,0" Spacing="4">
                        <Border
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8"
                            Padding="16,4">
                            <StackPanel>
                                <ToggleSwitch
                                    x:Name="StickyEnabledSwitch"
                                    Header="启用便签与全局热键"
                                    OffContent="关闭"
                                    OnContent="开启" />

                                <Grid Margin="0,8,0,0" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock FontSize="13" Text="新建便签热键" />
                                        <TextBox
                                            x:Name="StickyHotkeyNewBox"
                                            LostFocus="StickyHotkeyBox_LostFocus"
                                            PlaceholderText="如 Ctrl+Alt+N" />
                                        <TextBlock
                                            x:Name="StickyHotkeyNewError"
                                            FontSize="11"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock FontSize="13" Text="便签列表热键" />
                                        <TextBox
                                            x:Name="StickyHotkeyBoardBox"
                                            LostFocus="StickyHotkeyBox_LostFocus"
                                            PlaceholderText="如 Ctrl+Alt+B" />
                                        <TextBlock
                                            x:Name="StickyHotkeyBoardError"
                                            FontSize="11"
                                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Margin="0,4,0,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="格式：Ctrl/Alt/Shift/Win 中至少一个 + 字母/数字/F1-F12，如 Ctrl+Alt+N；清空则不注册该热键"
                                    TextWrapping="Wrap" />

                                <ToggleSwitch
                                    x:Name="StickyQuickDismissSwitch"
                                    Header="快速录入窗失焦 1.5 秒后自动保存"
                                    Margin="0,8,0,0" />

                                <Grid Margin="0,8,0,0" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <NumberBox
                                        x:Name="StickyRetentionBox"
                                        Grid.Column="0"
                                        Header="回收站保留天数"
                                        LargeChange="10"
                                        Maximum="3650"
                                        Minimum="1"
                                        SpinButtonPlacementMode="Inline"
                                        Value="30"
                                        Width="160" />
                                </Grid>

                                <Border
                                    Margin="0,12,0,4"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,12,0,4">
                                    <StackPanel Spacing="8">
                                        <ToggleSwitch
                                            x:Name="StickySyncSwitch"
                                            Header="通过 WebDAV 同步便签"
                                            OffContent="关闭"
                                            OnContent="开启" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                            Text="多设备按最后修改时间合并；同一条便签两端都修改时保留双方内容并标记冲突。需先在「数据同步」中开启并配置 WebDAV。"
                                            TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <Button
                                                x:Name="StickySyncNowButton"
                                                Click="StickySyncNow_Click"
                                                Content="立即同步" />
                                            <TextBlock
                                                x:Name="StickyLastSyncText"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="从未同步" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
</UserControl>
