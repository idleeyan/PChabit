<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="PChabit.App.Views.Settings.GeneralSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

            <Border x:Name="GeneralSection" Style="{StaticResource CardStyle}">
                <StackPanel Spacing="20">
                    <!-- 分组标题 -->
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border
                                Width="32"
                                Height="32"
                                Background="{StaticResource PrimarySoftBrush}"
                                CornerRadius="6">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Glyph="&#xE713;" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="基本设置" />
                        </StackPanel>
                        <TextBlock
                            Margin="44,0,0,0"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="这些设置控制应用程序的启动和显示行为"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border
                        Margin="44,0,0,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8"
                        Padding="16,4">
                        <StackPanel Spacing="0">
                            <ToggleSwitch
                                x:Name="StartWithWindowsSwitch"
                                Header="开机自启动"
                                IsOn="True" />
                            <ToggleSwitch
                                x:Name="MinimizeToTraySwitch"
                                Header="最小化到系统托盘" />
                            <ToggleSwitch
                                x:Name="ShowNotificationsSwitch"
                                Header="显示通知" />
                            <ToggleSwitch
                                x:Name="AutoStartMonitoringSwitch"
                                Header="自动开始监控" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
</UserControl>
