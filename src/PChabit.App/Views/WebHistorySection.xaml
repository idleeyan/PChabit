<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="PChabit.App.Views.WebHistorySection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PChabit.App.ViewModels"
    xmlns:controls="using:PChabit.App.Controls"
    mc:Ignorable="d">

    <!--
        3.38.0：UserControl 只能有单一 Content，故用 Grid 承载
        「主卡片」与「域名详情弹窗」两层。
    -->
    <Grid>
    <!--
        3.36.0：原「网页浏览历史」独立页签（WebView2 + report.html）原生化后并入本页。
        HTML 报告是浅色硬编码样式（#f3f4f6 背景、白卡片投影、24px 标题），
        与全应用主题自适应的原生卡片画风割裂，故改为原生界面。
        保留其独有价值：按域名聚合的明细（搜索 + CSV 导出 + 域名下钻）。
        「每日趋势 / 24h 分布 / TOP10」等与上方统计卡片重复，不再重复呈现。
    -->
    <Border
        Padding="16"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="12">

        <StackPanel Spacing="12">
            <Grid>
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="浏览历史 · 域名明细" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Padding="12,6"
                        Click="Refresh_Click"
                        Content="&#xE72C;"
                        FontFamily="Segoe MDL2 Assets"
                        ToolTipService.ToolTip="刷新历史库统计" />
                    <Button
                        Padding="12,6"
                        Command="{x:Bind ViewModel.ExportCsvCommand}"
                        Content="导出 CSV" />
                </StackPanel>
            </Grid>

            <TextBlock
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="数据来自浏览器本机历史库，与上方按会话统计的「网站访问排行」口径不同" />

            <!--
                3.37.0：数据陈旧告警。浏览历史依赖扩展推送，采集一旦被关
                界面就会静默停更，用户无从区分「没变化」与「坏了」。
            -->
            <Border
                Padding="12,10"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{x:Bind ViewModel.IsStale, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Glyph="&#xE7BA;" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{x:Bind ViewModel.StaleReason, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Button
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Padding="12,6"
                        Click="EnableIngest_Click"
                        Content="开启采集"
                        Visibility="{x:Bind ViewModel.IsIngestDisabled, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="SearchBox"
                    Header="搜索域名"
                    PlaceholderText="输入域名关键字过滤"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.RangeText, Mode=OneWay}" />
            </Grid>

            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="加载中…"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="未查询到符合条件的域名"
                Visibility="{x:Bind ViewModel.HasNoRows, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- 表头 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="11" FontWeight="SemiBold" Text="域名（可点击查看详情）" />
                <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Text="记录数" />
                <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Text="唯一 URL" />
                <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" Text="占比" />
                <TextBlock Grid.Column="4" FontSize="11" FontWeight="SemiBold" Text="最近访问" />
            </Grid>

            <!--
                3.38.0：域名改为可点击，还原原 HTML 报告的域名详情能力。
                ListViewItem 选中态本身已是蓝色底，额外再放 HyperlinkButton 会
                出现双重高亮，故只加 Hover 提示 + 点击事件。
            -->
            <ListView
                x:Name="DomainList"
                IsItemClickEnabled="True"
                ItemClick="DomainList_ItemClick"
                ItemsSource="{x:Bind ViewModel.FilteredDomains, Mode=OneWay}"
                MaxHeight="360"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryDomainRow">
                        <Grid
                            Padding="4,2"
                            ColumnSpacing="12"
                            ToolTipService.ToolTip="点击查看该域名的详细情况">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Bind Domain}" />

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind RecordCount}" />

                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind UniqueUrlCount}" />

                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind PercentageText}" />

                            <TextBlock
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind LastVisitText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Border>

    <!--
        3.38.0：域名详情弹窗，还原原 HTML 报告 report.js 的 showDomainDetail 能力
        （统计卡片 + 每日趋势 + 24h 时段分布 + URL 列表前 20）。
        用 ContentDialog 而非自绘浮层：可复用应用既有的焦点/ESC 关闭行为，
        且不需要处理遮罩与 z 序。
    -->
    <ContentDialog
        x:Name="DetailDialog"
        CloseButtonText="关闭"
        DefaultButton="Close"
        PrimaryButtonText="在浏览器中打开"
        Title="{x:Bind ViewModel.DetailDomain, Mode=OneWay}">

        <ScrollViewer MaxHeight="560">
            <StackPanel Spacing="16">
                <!-- 统计卡片 -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Padding="10"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8">
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="总记录数" />
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.DetailTotalVisits, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="10"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8">
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="独立页面" />
                            <TextBlock
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.DetailUniqueUrls, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="2"
                        Padding="10"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8">
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="首次访问" />
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.DetailFirstVisitText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="3"
                        Padding="10"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8">
                        <StackPanel Spacing="2">
                            <TextBlock
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="最后访问" />
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.DetailLastVisitText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 每日访问趋势：原生柱状（与全应用图表风格统一） -->
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="每日访问趋势" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.DetailDailyTrend, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryDailyPoint">
                                <StackPanel
                                    Margin="0,0,4,0"
                                    Width="26"
                                    ToolTipService.ToolTip="{x:Bind DateLabel}">
                                    <Grid Height="70">
                                        <!-- 反转Y 轴让柱子向上生长 -->
                                        <ProgressBar
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Bottom"
                                            Height="{x:Bind CountHeight, Mode=OneWay}"
                                            Maximum="1"
                                            Value="1" />
                                    </Grid>
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="10"
                                        HorizontalAlignment="Center"
                                        Text="{x:Bind DateLabel}" />
                                    <TextBlock
                                        FontSize="10"
                                        HorizontalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Count}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 24 小时时段分布：复用共享图表控件 -->
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="时段分布" />
                    <controls:HourlyBarChart
                        EmptyText="该域名暂无时段数据"
                        LabelWidth="46"
                        RowSpacing="2"
                        ValueWidth="56"
                        Rows="{x:Bind ViewModel.DetailHourlyRows, Mode=OneWay}" />
                </StackPanel>

                <!-- URL 列表（原报告取前 20） -->
                <StackPanel Spacing="8">
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="访问过的页面（按记录数取前 20）" />
                    <ListView
                        ItemsSource="{x:Bind ViewModel.DetailUrls, Mode=OneWay}"
                        MaxHeight="240"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryUrlRow">
                                <Grid
                                    Padding="0,4"
                                    ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind Count}" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock
                                            FontSize="12"
                                            Text="{x:Bind Title}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Title}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Url}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Url}" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind LastVisitText}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </ContentDialog>
    </Grid>
</UserControl>