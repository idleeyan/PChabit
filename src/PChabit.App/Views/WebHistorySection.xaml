<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="PChabit.App.Views.WebHistorySection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:PChabit.App.ViewModels"
    mc:Ignorable="d">

    <!--
        3.36.0：原「网页浏览历史」独立页签（WebView2 + report.html）原生化后并入本页。
        HTML 报告是浅色硬编码样式（#f3f4f6 背景、白卡片投影、24px 标题），
        与全应用主题自适应的原生卡片画风割裂，故改为原生界面。
        保留其独有价值：按域名聚合的明细（搜索 + CSV 导出）。
        「每日趋势 / 24h 分布 / TOP10」等与上方统计卡片重复，不再重复呈现。
    -->
    <Border
        Padding="16"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="12">

        <StackPanel Spacing="12">
            <Grid>
                <StackPanel>
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="浏览历史 · 域名明细" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Padding="12,6"
                        Click="Refresh_Click"
                        Content="&#xE72C;"
                        FontFamily="Segoe MDL2 Assets"
                        ToolTipService.ToolTip="刷新历史库统计" />
                    <Button
                        Padding="12,6"
                        Command="{x:Bind ViewModel.ExportCsvCommand}"
                        Content="导出 CSV" />
                </StackPanel>
            </Grid>

            <TextBlock
                FontSize="11"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="数据来自浏览器本机历史库，与上方按会话统计的「网站访问排行」口径不同" />

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="SearchBox"
                    Header="搜索域名"
                    PlaceholderText="输入域名关键字过滤"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.RangeText, Mode=OneWay}" />
            </Grid>

            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="加载中…"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="未查询到符合条件的域名"
                Visibility="{x:Bind ViewModel.HasNoRows, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- 表头 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="11" FontWeight="SemiBold" Text="域名" />
                <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Text="记录数" />
                <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Text="唯一 URL" />
                <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" Text="占比" />
                <TextBlock Grid.Column="4" FontSize="11" FontWeight="SemiBold" Text="最近访问" />
            </Grid>

            <ListView
                ItemsSource="{x:Bind ViewModel.FilteredDomains, Mode=OneWay}"
                MaxHeight="360"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:HistoryDomainRow">
                        <Grid
                            Padding="4,2"
                            ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{x:Bind Domain}" />

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind RecordCount}" />

                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind UniqueUrlCount}" />

                            <TextBlock
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind PercentageText}" />

                            <TextBlock
                                Grid.Column="4"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind LastVisitText}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Border>
</UserControl>