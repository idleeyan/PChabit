<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="PChabit.App.Views.AnalyticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:PChabit.App.Views"
    xmlns:vm="using:PChabit.App.ViewModels"
    mc:Ignorable="d">

    <!--
      3.57.0：原「总览/节奏构成/硬件/应用流向」四页签合并为单页，纵向滚动。
      删除：复制周报、导出 Excel、AI 深度解读/洞察 整块、多源数据摘要卡、习惯养成轨迹。
    -->
    <ScrollViewer
        Padding="20,12,20,24"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Spacing="16"
            MaxWidth="1100"
            HorizontalAlignment="Left">

            <!-- 顶部：标题 + 周期 + 刷新 + 网页浏览历史 -->
            <Grid HorizontalAlignment="Stretch">
                <StackPanel Spacing="2" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource PageTitleStyle}" Text="分析" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.PeriodRangeText, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ComboBox
                        MinWidth="110"
                        ItemsSource="{x:Bind ViewModel.PeriodOptions}"
                        SelectedItem="{x:Bind ViewModel.SelectedPeriodKey, Mode=TwoWay}" />
                    <Button Padding="12,6" Click="Refresh_Click" Content="刷新" />
                    <Button
                        Padding="12,6"
                        Command="{x:Bind ViewModel.OpenHistoryReportCommand}"
                        Content="网页浏览历史" />
                </StackPanel>
            </Grid>

            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{x:Bind ViewModel.DataQualityDetail, Mode=OneWay}" />

            <TextBlock
                FontSize="12"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Text="{x:Bind ViewModel.DataQualityText, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.ShowLowDataBanner, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!-- KPI 卡（仅 4 项） -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{x:Bind ViewModel.ShownKpis, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Width="168"
                                Margin="0,0,8,0"
                                Padding="12"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontSize="12"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="{Binding Value}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{Binding DeltaDirection, Converter={StaticResource TrendColorConverter}}"
                                        Text="{Binding DeltaText}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        Text="{Binding Hint}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{Binding Hint}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 近 14 天活跃热力 -->
            <Border
                Padding="16"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="近 14 天活跃热力" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="点击某天可跳转时间线" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.CalendarDays, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="62"
                                        Height="54"
                                        Margin="0,0,6,0"
                                        Tapped="DayHeat_Tapped"
                                        Tag="{Binding Date}"
                                        ToolTipService.ToolTip="{Binding DateLabel}">
                                        <Border.Background>
                                            <SolidColorBrush Color="#1E40AF" Opacity="{Binding IntensityLevel, Converter={StaticResource HeatLevelToOpacityConverter}}" />
                                        </Border.Background>
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="1">
                                            <TextBlock HorizontalAlignment="Center" FontSize="10" Text="{Binding DayLabel}" />
                                            <TextBlock HorizontalAlignment="Center" FontSize="11" FontWeight="SemiBold" Text="{Binding DateLabel}" />
                                            <TextBlock HorizontalAlignment="Center" FontSize="10" Text="{Binding HoursText}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- 节奏：24 小时四维分布 -->
            <Border
                x:Name="RhythmCard"
                Padding="16"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="24 小时四维分布" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="活跃 / 网页 / 流量逐小时对齐" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.HourHeat, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="26"
                                        Height="34"
                                        Margin="0,0,3,0"
                                        ToolTipService.ToolTip="{Binding Label}">
                                        <Border.Background>
                                            <SolidColorBrush Color="#10B981" Opacity="{Binding IntensityLevel, Converter={StaticResource HeatLevelToOpacityConverter}}" />
                                        </Border.Background>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="9"
                                            Text="{Binding Label}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="网页浏览（分钟）" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.HourWeb, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="26"
                                        Height="34"
                                        Margin="0,0,3,0"
                                        ToolTipService.ToolTip="{Binding Minutes}">
                                        <Border.Background>
                                            <SolidColorBrush Color="#6366F1" Opacity="{Binding IntensityLevel, Converter={StaticResource HeatLevelToOpacityConverter}}" />
                                        </Border.Background>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="9"
                                            Text="{Binding Label}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="下行流量（MB）" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.HourNet, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="26"
                                        Height="34"
                                        Margin="0,0,3,0"
                                        ToolTipService.ToolTip="{Binding Minutes}">
                                        <Border.Background>
                                            <SolidColorBrush Color="#F59E0B" Opacity="{Binding IntensityLevel, Converter={StaticResource HeatLevelToOpacityConverter}}" />
                                        </Border.Background>
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="9"
                                            Text="{Binding Label}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- 应用变化（对比上一周期） -->
            <Border
                x:Name="ComposeCard"
                Padding="16"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="{x:Bind ViewModel.HasTopChanges, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                    <TextBlock FontWeight="SemiBold" Text="应用变化（对比上一周期）" />
                    <ItemsControl
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.TopChanges, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4" HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" MinWidth="64" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Text="{Binding DurationText}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="12,0,0,0"
                                        HorizontalAlignment="Right"
                                        FontWeight="SemiBold"
                                        Foreground="{Binding Direction, Converter={StaticResource TrendColorConverter}}"
                                        Text="{Binding DeltaText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 硬件：周期汇总 -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="{x:Bind ViewModel.HasHardwareProfile, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Spacing="6">
                    <TextBlock FontWeight="SemiBold" Text="硬件周期汇总" />
                    <TextBlock
                        FontSize="13"
                        TextWrapping="Wrap"
                        Text="{x:Bind ViewModel.HardwareSummaryText, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <!-- 硬件：应用负载 Top -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="{x:Bind ViewModel.HasHardwareProfile, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="应用负载 Top（按 GPU 均值）" />
                    <Grid Margin="0,0,0,4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="应用" />
                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="CPU" />
                        <TextBlock Grid.Column="2" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="GPU" />
                        <TextBlock Grid.Column="3" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="峰温" />
                        <TextBlock Grid.Column="4" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="重叠" />
                    </Grid>
                    <ItemsControl
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.HardwareAppLoads, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4" HorizontalAlignment="Stretch" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" FontSize="12" Text="{Binding CpuText}" />
                                    <TextBlock Grid.Column="2" FontSize="12" FontWeight="SemiBold" Text="{Binding GpuText}" />
                                    <TextBlock Grid.Column="3" FontSize="12" Text="{Binding TempText}" />
                                    <TextBlock Grid.Column="4" FontSize="12" Text="{Binding MinutesText}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 硬件：小时 CPU/GPU 负载 -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="{x:Bind ViewModel.HasHardwareProfile, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Spacing="10">
                    <TextBlock FontWeight="SemiBold" Text="小时 CPU / GPU 负载（有样本时段）" />
                    <local:HardwareTrendView
                        x:Name="HardwareTrend"
                        ChartJson="{x:Bind ViewModel.HardwareChartJson, Mode=OneWay}"
                        MinHeight="250" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="绿 CPU% · 蓝 GPU% · 橙 GPU 温度（右轴估算）" />
                </StackPanel>
            </Border>

            <!-- 硬件：无数据提示 -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="{x:Bind ViewModel.HasHardwareProfile, Mode=OneWay, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <TextBlock
                    FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="本周期尚无硬件分钟样本。请确认硬件监控已开启并运行一段时间；历史日期无法回填。" />
            </Border>

            <!-- 应用流向 Sankey -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="应用流向" />
                    <local:SankeyView HorizontalAlignment="Stretch" MinHeight="320" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>