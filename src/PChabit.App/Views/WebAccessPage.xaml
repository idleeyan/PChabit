<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="PChabit.App.Views.WebAccessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:PChabit.App.Views"
    mc:Ignorable="d">

    <!--
        3.36.0：去掉「访问统计 / 网页浏览历史」二级页签，合并为单页。
        原「网页浏览历史」是 WebView2 加载 report.html，浅色硬编码样式与全应用
        主题自适应的原生卡片画风割裂；现已将其域名明细原生化并入统计页底部
        （见 WebHistorySection），故不再需要独立页签。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="24,24,24,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="网页访问" />
                <Button
                    Padding="12,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="OpenCategoryManager_Click"
                    Content="分类管理 →" />
            </Grid>
        </Border>

        <views:WebStatsTab x:Name="StatsSection" Grid.Row="1" />
    </Grid>
</Page>