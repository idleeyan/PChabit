<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="PChabit.App.Views.WebAccessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:PChabit.App.Views"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="24,24,24,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="网页访问" />
                <Button
                    Padding="12,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="OpenCategoryManager_Click"
                    Content="分类管理 →" />
            </Grid>
        </Border>

        <Pivot x:Name="RootPivot" Grid.Row="1">
            <PivotItem Header="访问统计" Tag="stats">
                <views:WebStatsTab />
            </PivotItem>
            <PivotItem Header="网页浏览历史" Tag="history">
                <views:HistoryReportTab />
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
